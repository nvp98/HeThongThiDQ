@{
    ViewBag.Title = "Quản Lý Chủ Đề Thi";
    Layout = "~/Views/Shared/_Layout.cshtml";
}

@using X.PagedList
@using X.PagedList.Mvc.Core
@model IPagedList<ManageClassValidation>

<link href="~/Content/assets/css/PagedList.css" rel="stylesheet" />

@if (TempData["msgSuccess"] != null)
{
    @Html.Raw(TempData["msgSuccess"])
}
@if (TempData["msgError"] != null)
{
    @Html.Raw(TempData["msgError"])
}

<div class="app-main__outer">
    <div class="app-main__inner">

        <div class="app-page-title">
            <div class="page-title-wrapper">
                <div class="page-title-heading">
                    <div class="page-title-icon">
                        <i class="pe-7s-portfolio icon-gradient bg-grow-early"></i>
                    </div>
                    <div>
                        Quản Lý Chủ đề thi
                        <div class="page-title-subheading"></div>
                    </div>
                </div>
            </div>
        </div>

        <div class="tab-content">
            <div class="row">
                <div class="card col-lg-12">
                    <div class="card-header">
                        <div class="col-md-8">
                            <div class="row">
                                <div class="col-md-3">
                                    <div class="row">
                                        <select name="IDLH" id="IDLH" asp-items="(SelectList)ViewBag.IDLH" class="form-control marginTB5" style="width:100%">
                                            <option value="">--Lớp học--</option>
                                        </select>
                                    </div>
                                </div>
                                &nbsp;&nbsp;
                                <div class="col-md-4">
                                    <div class="row">
                                        <select name="IDND" id="IDND" asp-items="(SelectList)ViewBag.IDND" class="form-control marginTB5" style="width:100%">
                                            <option value="">--Nội dung--</option>
                                        </select>
                                    </div>
                                </div>
                                &nbsp;&nbsp;
                                <div class="col-md-2">
                                    <div class="row">
                                        <select name="IDPB" id="IDPB" asp-items="(SelectList)ViewBag.IDPB" class="form-control marginTB5" style="width:100%">
                                            <option value="">--Bộ Phận--</option>
                                        </select>
                                    </div>
                                </div>
                                <div class="col-md-2">
                                    <div class="input-group-btn">
                                        <button class="btn btn-primary marginTB5" id="btn-search"><i class="fa fa-search"></i> Tìm kiếm</button>
                                    </div>
                                </div>
                            </div>
                        </div>

                        <div class="col-md-4">
                            @if ((ViewBag.QUYENCN as List<string>).Contains(CONSTKEY.EX))
                            {
                                <button type="button" id="btn-ExportLH" class="btn btn-success m-l-auto"><i class="fa fa-file-excel-o">&nbsp;</i>&nbsp;Danh sách lớp học</button>
                                <button type="button" id="btn-ExportOnLuyen" class="btn btn-info m-l-auto" title="Xuất kết quả ôn luyện theo đơn vị"><i class="fa fa-file-excel-o">&nbsp;</i>&nbsp;Ôn luyện</button>
                                <button type="button" id="btn-ExportThi" class="btn btn-primary m-l-auto" title="Xuất kết quả thi chính thức theo đơn vị"><i class="fa fa-file-excel-o">&nbsp;</i>&nbsp;Thi chính thức</button>
                            }
                            <button type="button" id="btn-Export" class="btn btn-success m-l-auto"><i class="fa fa-file-excel-o">&nbsp;</i>&nbsp;Biểu Mẫu DSHV</button>
                            <span class="modal fade" id="myModalimport" role="dialog" data-url="@Url.Action("ExportToExcel","ManageClass")"></span>
                            @if ((ViewBag.QUYENCN as List<string>).Contains(CONSTKEY.ADD))
                            {
                                <button type="button" id="btn-add" class="btn btn-primary m-l-auto"><i class="fa fa-plus">&nbsp;</i>&nbsp;Thêm mới</button>
                                <button type="button" id="btn-sinh-lop-hl" class="btn btn-warning m-l-auto" title="Sinh lớp học hàng loạt theo danh sách đề ôn luyện">
                                    <i class="fa fa-th-list"></i>&nbsp;Sinh lớp ôn luyện
                                </button>
                                <button type="button" id="btn-sync-thisinh" class="btn btn-info m-l-auto" title="Sync thí sinh từ danh sách nhân sự đang làm việc">
                                    <i class="fa fa-refresh"></i>&nbsp;Sync thí sinh
                                </button>
                                <span class="modal fade" id="myModal" role="dialog" data-url="@Url.Action("Create","ManageClass")"></span>
                                <span class="modal fade" id="myModalSinhLopHL" role="dialog" data-url="@Url.Action("SinhLopHangLoat","ManageClass")"></span>
                                <span class="modal fade" id="myModalSyncThiSinh" role="dialog" data-url="@Url.Action("SyncThiSinh","ManageClass")"></span>
                            }
                        </div>
                    </div>
                    <div class="card-body">
                        <div class="table-responsive">
                            <table class="table table-bordered table-hover" id="table" width="100%" cellpadding="0">
                                <thead class="thead-light">
                                    <tr>
                                        <th width="30px" class="text-center">STT</th>
                                        <th class="text-center">Mã LH</th>
                                        <th class="text-center">Tên Chủ đề thi</th>
                                        <th class="text-center">Lĩnh Vực</th>
                                        <th class="text-center">Nội Dung Đào Tạo</th>
                                        <th class="text-center">Quý</th>
                                        <th class="text-center">Năm</th>
                                        <th class="text-center">TG Bắt Đầu</th>
                                        <th class="text-center">TG Kết Thúc</th>
                                        <th class="text-center">Đề Thi</th>
                                        <th class="text-center">SL HT / TSL HV</th>
                                        <th class="text-center">Giảng viên</th>
                                        <th class="text-center">Phòng Ban</th>
                                        <th width="120px" class="text-center">Thao tác</th>
                                    </tr>
                                </thead>
                                <tbody>
                                    @{
                                        int pageno = Model.PageNumber;
                                        int itemperpage = Model.PageSize;
                                        int RowNo = ((pageno - 1) * itemperpage) + 1;
                                    }
                                    @foreach (var item in Model)
                                    {
                                        <tr>
                                            <td class="text-center">@RowNo@{ RowNo++; }</td>
                                            <td>@item.MaLH</td>
                                            <td>@item.TenLH</td>
                                            <td class="text-center">@item.LinhVuc</td>
                                            <td>@item.TenND</td>
                                            <td class="text-center">@item.QuyDT</td>
                                            <td class="text-center">@item.NamDT</td>
                                            <td class="text-center">@item.TGBDLH.ToString("dd-MM-yyyy")</td>
                                            <td class="text-center">@item.TGKTLH.ToString("dd-MM-yyyy")</td>
                                            <td class="text-center">@item.TenDeThi</td>
                                            <td class="text-center">@item.SLHT / @item.TSLHV</td>
                                            <td class="text-center">@item.MaGV - @item.TenGV</td>
                                            <td class="text-center">@item.TenPhongBan</td>
                                            <td class="text-center">
                                                <a title="DS Lớp" class="fa fa-list-alt" id="@item.IDLH" href="@Url.Action("Index", "ConfirmEStudy", new { id = item.IDLH })"></a>
                                                @if ((ViewBag.QUYENCN as List<string>).Contains(CONSTKEY.VIEW_ALL))
                                                {
                                                    <a title="DS Câu Hỏi" class="fa fa-file-text" id="@item.IDDeThi" href="@Url.Action("ViewQuestion", "ManageTestExam", new { id = item.IDDeThi })"></a>
                                                }
                                                @if ((ViewBag.QUYENCN as List<string>).Contains(CONSTKEY.EDIT))
                                                {
                                                    <a id="btn-edit_@item.IDLH" title="Sửa" class="fa fa-edit icon_action"></a>
                                                    <div class="modal fade" id="myModale_@item.IDLH" role="dialog" data-url="@Url.Action("Edit","ManageClass", new { id = item.IDLH })"></div>
                                                    <script type="text/javascript">
                                                        $("#btn-edit_@item.IDLH").click(function () {
                                                            var url = $('#myModale_@item.IDLH').data('url');
                                                            $.get(url, function (data) {
                                                                $("#myModal").html(data);
                                                                $("#ModalTitle").html("Cập nhật Lớp Học");
                                                                $("#myModal").modal('show');
                                                            });
                                                        });
                                                    </script>
                                                    <a id="btn-pool_@item.IDLH" title="Pool đề thi (random)" class="fa fa-random icon_action" style="color:#6f42c1"></a>
                                                    <div class="modal fade" id="myModalPool_@item.IDLH" role="dialog" data-url="@Url.Action("DeThiPool","ManageClass", new { idlh = item.IDLH })"></div>
                                                    <script type="text/javascript">
                                                        $("#btn-pool_@item.IDLH").click(function () {
                                                            var url = $('#myModalPool_@item.IDLH').data('url');
                                                            $.get(url, function (data) {
                                                                $("#myModal").html(data);
                                                                $("#myModal").modal('show');
                                                            });
                                                        });
                                                    </script>
                                                }
                                                @if ((ViewBag.QUYENCN as List<string>).Contains(CONSTKEY.DEL))
                                                {
                                                    <a class="fa fa-trash icon_action" title="Xóa"
                                                       href="@Url.Action("Delete", "ManageClass", new { id = item.IDLH })"
                                                       onclick="return confirm('Bạn muốn xóa Lớp Học: @item.TenLH')"></a>
                                                }
                                            </td>
                                        </tr>
                                    }
                                </tbody>
                            </table>
                            <div class="pager">
                                @Html.PagedListPager(Model, page => Url.Action("Index", "ManageClass", new { page, IDLH = Context.Request.Query["IDLH"], IDPB = Context.Request.Query["IDPB"], IDND = Context.Request.Query["IDND"] }))
                                <span class="pageoff">Trang @(Model.PageCount < Model.PageNumber ? 0 : Model.PageNumber) / @Model.PageCount</span>
                            </div>
                        </div>
                    </div>
                </div>
            </div>
        </div>

    </div>

    <div class="app-wrapper-footer">
        <div class="app-footer">
            <div class="app-footer__inner"></div>
        </div>
    </div>
</div>

<!-- Modal chọn đơn vị để xuất Excel -->
<div class="modal fade" id="modalExportPB" tabindex="-1" role="dialog">
    <div class="modal-dialog" role="document" style="max-width:480px">
        <div class="modal-content">
            <div class="modal-header">
                <h5 class="modal-title"><i class="fa fa-file-excel-o"></i> Chọn đơn vị xuất dữ liệu</h5>
                <button type="button" class="close" data-dismiss="modal"><span>&times;</span></button>
            </div>
            <div class="modal-body" style="max-height:380px;overflow-y:auto">
                <div class="mb-2" id="lopThiExportWrap" style="display:none">
                    <label style="font-weight:700;margin-bottom:4px">Lớp thi chính thức</label>
                    <select id="selLopThiExport" class="form-control"></select>
                    <hr style="margin:10px 0">
                </div>
                <div class="mb-2">
                    <label style="font-weight:700;cursor:pointer">
                        <input type="checkbox" id="cbAllPB" checked style="margin-right:6px">
                        Chọn tất cả đơn vị
                    </label>
                </div>
                <hr style="margin:6px 0 10px">
                <div id="pbCheckList">
                    @foreach (var pb in (IEnumerable<dynamic>)ViewBag.PhongBanList)
                    {
                        <div class="mb-1">
                            <label style="font-weight:400;cursor:pointer">
                                <input type="checkbox" class="cb-pb-item" value="@pb.IdphongBan" checked style="margin-right:6px">
                                @pb.TenPhongBan
                            </label>
                        </div>
                    }
                </div>
            </div>
            <div class="modal-footer">
                <button type="button" class="btn btn-secondary" data-dismiss="modal">Hủy</button>
                <button type="button" class="btn btn-success" id="btn-do-export">
                    <i class="fa fa-download"></i> Xuất Excel
                </button>
            </div>
        </div>
    </div>
</div>

<script type="text/javascript">
    $('#btn-add').click(function () {
        var url = $('#myModal').data('url');
        $.get(url, function (data) {
            $("#myModal").html(data);
            $("#ModalTitle").html("Thêm mới Lớp Học");
            $("#myModal").modal('show');
        });
    });

    $('#btn-sinh-lop-hl').click(function () {
        var url = $('#myModalSinhLopHL').data('url');
        $.get(url, function (data) {
            $("#myModal").html(data);
            $("#myModal").modal({ backdrop: "static" });
            $("#myModal").modal('show');
        });
    });

    $('#btn-sync-thisinh').click(function () {
        var url = $('#myModalSyncThiSinh').data('url');
        $.get(url, function (data) {
            $("#myModal").html(data);
            $("#myModal").modal({ backdrop: "static" });
            $("#myModal").modal('show');
        });
    });

    $('#btn-Export').click(function () {
        window.location.href = "/ManageClass/ExportToExcel";
    });

    $('#btn-ExportLH').click(function () {
        window.location.href = "/ManageClass/ExportToExcelLH";
    });

    var _exportType = '';
    $('#btn-ExportOnLuyen').click(function () {
        _exportType = 'on-luyen';
        $('#lopThiExportWrap').hide();
        $('#modalExportPB').modal('show');
    });
    $('#btn-ExportThi').click(function () {
        _exportType = 'chinh-thuc';
        // Có thể có lớp thi lại → chọn lớp cần xuất (mặc định lớp mới nhất)
        $.getJSON('/XepHangCaNhan/GetLopThi', function (list) {
            list = Array.isArray(list) ? list : [];
            $('#selLopThiExport').html(list.map(function (l) {
                return '<option value="' + l.Idlh + '">' + $('<div>').text(l.TenLH).html() + '</option>';
            }).join(''));
            $('#lopThiExportWrap').toggle(list.length > 1);
        });
        $('#modalExportPB').modal('show');
    });

    $('#cbAllPB').on('change', function () {
        $('.cb-pb-item').prop('checked', $(this).prop('checked'));
    });
    $(document).on('change', '.cb-pb-item', function () {
        $('#cbAllPB').prop('checked', $('.cb-pb-item').length === $('.cb-pb-item:checked').length);
    });

    $('#btn-do-export').on('click', function () {
        var ids = [];
        if (!$('#cbAllPB').prop('checked')) {
            ids = $('.cb-pb-item:checked').map(function () { return $(this).val(); }).get();
            if (ids.length === 0) { alert('Vui lòng chọn ít nhất một đơn vị.'); return; }
        }
        var url = _exportType === 'on-luyen'
            ? '/ManageClass/ExportOnLuyen'
            : '/ManageClass/ExportThiChinhThuc';
        var params = ids.map(function (id) { return 'idPBs=' + id; });
        if (_exportType === 'chinh-thuc' && $('#selLopThiExport').val())
            params.push('idlh=' + $('#selLopThiExport').val());
        var qs = params.join('&');
        window.location.href = url + (qs ? '?' + qs : '');
        $('#modalExportPB').modal('hide');
    });

    $("#IDPB,#IDLH,#IDND").chosen({ width: "100%" });

    $("#btn-search").on('click', function () {
        window.location.href = '@Url.Action("Index", "ManageClass")?IDPB=' + $('#IDPB').val() + '&IDLH=' + $('#IDLH').val() + '&IDND=' + $('#IDND').val();
    });
</script>
