        </script>
        <script>
            $(document).ready(function () {
            if (@showQuanTriKNL == 1) { $("#QuanTriKNL").css("display", "block"); }
            if (@showKNL        == 1) { $("#KNL").css("display", "block"); }
            if (@showQuanTri    == 1) { $("#QuanTri").css("display", "block"); }
            if (@showQTriKNL    == 1) { $("#QTriKNL").css("display", "block"); }
            if (@showQTriHV     == 1) { $("#QTriHV").css("display", "block"); }
            if (@showQTriCHDT   == 1) { $("#QTriCHDT").css("display", "block"); }

            // Active menu item theo URL hiện tại
            var cur = window.location.pathname.toLowerCase().replace(/\/index$/, '').replace(/\/$/, '') || '/';
            $('.vertical-nav-menu a[href]').each(function () {
            var href = ($(this).attr('href') || '').toLowerCase().replace(/\/index$/, '').replace(/\/$/, '');
            if (!href || href === '#') return;
            if (cur === href || cur.startsWith(href + '/') || cur.startsWith(href + '?')) {
            $(this).addClass('sb-active');
            $(this).closest('li').addClass('mm-active');
            // Mở parent submenu nếu là sub-item
            $(this).closest('ul.collapse, ul:not(.vertical-nav-menu)').prev('a').addClass('sb-active');
            $(this).closest('ul.collapse, ul:not(.vertical-nav-menu)').parent('li').addClass('mm-active');
            }
            });

            });
        </script>

        @await RenderSectionAsync("Scripts", required: false)
    </body>

</html>
