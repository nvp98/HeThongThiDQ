                                    </li>
                                }

                                <li id="QuanTriKNL" style="display: none" class="app-sidebar__heading">Quản trị tổ chức</li>

                                @* @if (ListControll.Contains("FDepartment"))
                                {
                                    <li>
                                        <a asp-controller="FDepartment" asp-action="Index">
                                            <i class="nav-icon fa fa-building-o"></i>Phòng Ban
                                        </a>
                                    </li>
                                    showQuanTriKNL = 1;
                                } *@

                            </ul>
                        </div>
                        <div class="app-sidebar__inner">
                            <ul class="vertical-nav-menu">
                                <li class="app-sidebar__heading">Trợ giúp</li>
                                <li>
                                    <a style="padding-left:0" href="tel:0946455576">
                                        <i class="metismenu-icon"></i>
                                        <strong>P.CNTT&CĐS -</strong>
                                        <strong>P.NS</strong>
                                    </a>
                                </li>
