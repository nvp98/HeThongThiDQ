                @RenderBody()

            </div>
        </div>

        <link href="~/Content/custom_responsive_mobile.css" rel="stylesheet" />
        <script type="text/javascript" src="~/Content/assets/scripts/main.js"></script>
        @* @if (Auth.IDQuyen != 1)
        {
            <!-- Non-admin: ẩn nút hamburger desktop, giữ mobile toggle hoạt động bình thường -->
            <style>
                @@media (min-width: 992px) {
