        color: #555 !important;
        border-left: 3px solid transparent !important;
        margin: 1px 8px !important;
        border-radius: 6px !important;
        display: block !important;
        }

        .vertical-nav-menu ul a:hover {
        background: #e8f0fe !important;
        color: #1a73e8 !important;
        border-left-color: #1a73e8 !important;
        }

        /* Caret icon trong dropdown */
        .metismenu-state-icon {
        margin-left: auto !important;
        font-size: 13px !important;
        }

        .app-header > .app-header__logo .logo-src {
        background: url(/Content/assets/images/logo.png) no-repeat center / contain !important;
        height: 42px !important;
        width: 160px !important;
        }
    </style>
</head>

