@{
    ViewBag.Title = "Danh sách người dùng";
    Layout = "~/Views/Shared/_Layout.cshtml";
}

@if (TempData["msgSuccess"] != null) { @Html.Raw(TempData["msgSuccess"]) }
@if (TempData["msgError"] != null)   { @Html.Raw(TempData["msgError"]) }

<style>input[type="checkbox"] { zoom: 1.3; position: relative; top: 3px; }</style>

<div class="app-main__outer">
    <div class="app-main__inner">

        <div class="app-page-title mb-0">
            <div class="page-title-wrapper">
                <div class="page-title-heading">
                    <div class="page-title-icon">
                        <i class="pe-7s-users icon-gradient bg-grow-early"></i>
                    </div>
                    <div>Danh sách người dùng theo nhóm quyền</div>
                </div>
            </div>
        </div>

        <div class="card mb-4">
            <div class="card-body">
                <div class="row mb-3">
                    <div class="form-group col-md-5">
                        <label class="font-weight-bold">Nhóm quyền</label>
                        @Html.DropDownList("SelectQuyen", null, "--Chọn nhóm quyền--",
                            new { id = "SelectQuyen", @class = "form-control", onchange = "changeQuyen(this.value)" })
                    </div>
                    <div class="col-md-auto d-flex align-items-end">
                        <button type="button" class="btn btn-primary btn-sm" id="btn-add">
                            <i class="fa fa-plus"></i>&nbsp;Thêm user
                        </button>
                        <div class="modal fade" id="myModal" role="dialog"></div>
                    </div>
                </div>

                <table class="table table-bordered table-hover" id="table">
                    <thead class="thead-light">
                        <tr>
                            <th class="text-center" width="60">STT</th>
                            <th>Họ tên</th>
                            <th>Phòng ban</th>
                            <th>Vị trí</th>
                            <th class="text-center" width="80">Thao tác</th>
                        </tr>
                    </thead>
                    <tbody id="tblBody"></tbody>
                </table>
            </div>
        </div>
    </div>
</div>

<script>
    function changeQuyen(id) {
        if (id) window.location.href = id;
    }

    function loadUsers() {
        var idq = $('#SelectQuyen').val();
        if (!idq) return;
        $.get('/FPermision/GetListUser', { id: idq }, function (data) {
            var tbody = $('#tblBody');
            tbody.empty();
            if (!data || data.length === 0) {
                tbody.append('<tr><td colspan="5" class="text-center text-muted">Chưa có người dùng</td></tr>');
                return;
            }
            $.each(data, function (i, row) {
                tbody.append(
                    '<tr>' +
                    '<td class="text-center">' + (i + 1) + '</td>' +
                    '<td>' + (row.HoTen || '') + '</td>' +
                    '<td>' + (row.PhongBan || '') + '</td>' +
                    '<td>' + (row.TenQuyen || '') + '</td>' +
                    '<td class="text-center">' +
                    '<a class="fa fa-sign-out icon_action text-danger" title="Xóa khỏi nhóm"' +
                    ' href="/FPermision/DeleteQuyen/' + row.ID + '?IDQuyen=' + idq + '"' +
                    ' onclick="return confirm(\'Xóa quyền của user: ' + (row.HoTen || '') + '?\')"></a>' +
                    '</td>' +
                    '</tr>'
                );
            });
        });
    }

    $('#btn-add').click(function () {
        var idq = $('#SelectQuyen').val();
        if (!idq) { alert('Vui lòng chọn nhóm quyền trước'); return; }
        $.get('/FPermision/AddUserQuyen?id=' + idq, function (data) {
            $('#myModal').html(data).modal('show');
        });
    });

    // Reload table after modal closes (after form submit redirect reloads page)
    $(document).ready(function () {
        $('#table').DataTable({ pageLength: 50, searching: true });
        loadUsers();
    });
</script>
