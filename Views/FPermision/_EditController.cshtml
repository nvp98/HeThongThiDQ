@model HeThongThiDQ.Models.ListControllerViewModel

<style>input[type="checkbox"] { zoom: 1.3; }</style>

<form asp-action="EditController" asp-controller="FPermision" method="post">
    <div class="modal-dialog" style="max-width:700px" id="formE">
        <div class="modal-content">
            <div class="modal-header">
                <h5 class="modal-title">Chỉnh sửa Controller</h5>
                <a href="#" class="close" data-dismiss="modal">&times;</a>
            </div>
            <div class="modal-body">
                <input type="hidden" name="ID" value="@Model.ID" />

                <div class="form-group">
                    <label class="font-weight-bold">Tên chức năng (Mô tả)</label>
                    <input name="Mota" class="form-control" value="@Model.Mota" />
                </div>
                <div class="form-group">
                    <label class="font-weight-bold">Controller</label>
                    <input name="Controller" class="form-control" value="@Model.Controller" />
                </div>

                <div class="form-group">
                    <label class="font-weight-bold">Quyền chi tiết</label>
                    <div class="row">
                        @for (int i = 0; i < Model.LSChecked.Count; i++)
                        {
                            <div class="col-md-4 mb-1">
                                <input type="checkbox"
                                       name="LSChecked[@i].IsChecked"
                                       value="true"
                                       @(Model.LSChecked[i].IsChecked ? "checked" : "") />
                                <input type="hidden" name="LSChecked[@i].IsChecked" value="false" />
                                <input type="hidden" name="LSChecked[@i].IdCN" value="@Model.LSChecked[i].IdCN" />
                                @Model.LSChecked[i].Name
                            </div>
                        }
                    </div>
                </div>

                <div class="form-group d-flex align-items-center">
                    <label class="font-weight-bold text-danger mr-2 mb-0">Hoạt động</label>
                    <input type="checkbox" name="IsCheck" value="true" @(Model.IsCheck ? "checked" : "") />
                    <input type="hidden" name="IsCheck" value="false" />
                </div>
            </div>
            <div class="modal-footer">
                <button type="submit" class="btn btn-primary">Xác nhận</button>
                <button type="button" class="btn btn-secondary" data-dismiss="modal">Hủy</button>
            </div>
        </div>
    </div>
</form>
