@model HeThongThiDQ.Controllers.AdminDashboardController.AdminDashboardData
@{
    ViewBag.Title = "Dashboard Quản trị";
    Layout = "~/Views/Shared/_Layout.cshtml";
}

<style>
    .dash-wrap {
        padding: 24px;
        background: #f0f2f5;
        min-height: calc(100vh - 60px);
        width: 100%;
        max-width: 100%;
        box-sizing: border-box;
        overflow-x: hidden;
    }

    /* ---- Stat cards ---- */
    .stat-grid {
        display: grid;
        grid-template-columns: repeat(auto-fit, minmax(200px, 1fr));
        gap: 16px;
        margin-bottom: 24px;
    }

    .stat-card {
        background: #fff;
        border-radius: 14px;
        padding: 20px 22px;
        display: flex;
        align-items: center;
        gap: 16px;
        box-shadow: 0 1px 6px rgba(0, 0, 0, .07);
        transition: transform .15s, box-shadow .15s;
    }

    .stat-card:hover {
        transform: translateY(-2px);
        box-shadow: 0 4px 16px rgba(0, 0, 0, .11);
    }

    .stat-icon {
        width: 52px;
        height: 52px;
        border-radius: 13px;
        display: flex;
        align-items: center;
        justify-content: center;
        font-size: 22px;
        flex-shrink: 0;
    }

    .stat-icon.blue {
        background: #e8f0fe;
        color: #1a73e8;
    }

    .stat-icon.green {
        background: #e6f4ea;
        color: #1e7e34;
    }

    .stat-icon.orange {
        background: #fef3e2;
        color: #e65100;
    }

    .stat-icon.purple {
        background: #f3e8fd;
        color: #7b1fa2;
    }

    .stat-num {
        font-size: 30px;
        font-weight: 800;
        color: #222;
        line-height: 1;
    }

    .stat-label {
        font-size: 12px;
        color: #888;
        margin-top: 3px;
    }

    /* ---- Chart + Table row ---- */
    .dash-row {
        display: grid;
        grid-template-columns: 1fr 1.6fr;
        gap: 16px;
    }

    .dash-row>.panel {
        min-width: 0;
    }

    @@media (max-width: 900px) {
        .dash-row {
            grid-template-columns: 1fr;
        }
    }

    /* ---- Panel ---- */
    .panel {
        background: #fff;
        border-radius: 14px;
        box-shadow: 0 1px 6px rgba(0, 0, 0, .07);
        overflow: hidden;
        min-width: 0;
    }

    .panel-head {
        padding: 14px 20px;
        border-bottom: 1px solid #f0f0f0;
        font-size: 14px;
        font-weight: 700;
        color: #333;
        display: flex;
        align-items: center;
        justify-content: space-between;
        gap: 8px;
        flex-wrap: wrap;
    }

    .panel-body {
        padding: 16px 20px;
    }

    /* ---- Table ---- */
    .dash-table {
        width: 100%;
        table-layout: fixed;
        border-collapse: collapse;
        font-size: 13px;
    }

    .dash-table th {
        background: #f8f9fa;
        color: #888;
        font-weight: 600;
        padding: 9px 12px;
        text-align: left;
        border-bottom: 1px solid #eee;
        font-size: 11px;
        text-transform: uppercase;
        letter-spacing: .4px;
    }

    .dash-table td {
        padding: 10px 12px;
        border-bottom: 1px solid #f5f5f5;
        color: #444;
        overflow-wrap: anywhere;
    }

    .dash-table tr:last-child td {
        border-bottom: none;
    }

    .dash-table tr:hover td {
        background: #fafbff;
    }

    .badge-online {
        display: inline-flex;
        align-items: center;
        gap: 5px;
        background: #e6f4ea;
        color: #1e7e34;
        border-radius: 20px;
        padding: 2px 10px;
        font-size: 11px;
        font-weight: 600;
    }

    .badge-online::before {
        content: '';
        width: 6px;
        height: 6px;
        border-radius: 50%;
        background: #34a853;
        animation: pulse-g .9s ease-in-out infinite;
    }

    @@keyframes pulse-g {

        0%,
        100% {
            opacity: 1
        }

        50% {
            opacity: .4
        }
    }

    /* ---- Refresh badge ---- */
    .refresh-badge {
        font-size: 11px;
        color: #aaa;
        font-weight: 400;
        display: flex;
        align-items: center;
        gap: 5px;
    }

    #refresh-dot {
        width: 7px;
        height: 7px;
        border-radius: 50%;
        background: #bbb;
        transition: background .3s;
    }

    #refresh-dot.active {
        background: #34a853;
    }

    /* ---- Empty state ---- */
    .empty-state {
        text-align: center;
        padding: 28px 0;
        color: #bbb;
        font-size: 13px;
    }

    /* ---- System perf panel ---- */
    .sys-grid {
        display: grid;
        grid-template-columns: 1fr 1fr;
        gap: 20px;
        margin-bottom: 16px;
    }

    .trend-header-info {
        flex-wrap: wrap;
        min-width: 0;
    }

    .trend-stat-chips {
        flex-wrap: wrap;
    }

    .sys-chips {
        flex-wrap: wrap;
    }

    @@media (max-width: 640px) {
        .sys-grid {
            grid-template-columns: 1fr;
        }
    }

    @@media (max-width: 900px) {
        .panel-head {
            align-items: flex-start;
        }

        .trend-stat-chips {
            justify-content: flex-start;
        }
    }

    .sys-metric-hd {
        display: flex;
        justify-content: space-between;
        align-items: baseline;
        margin-bottom: 7px;
    }

    .sys-metric-label {
        font-size: 12px;
        font-weight: 700;
        color: #666;
    }

    .sys-metric-val {
        font-size: 18px;
        font-weight: 800;
        color: #222;
    }

    .sys-bar-track {
        height: 9px;
        background: #f0f0f0;
        border-radius: 5px;
        overflow: hidden;
        margin-bottom: 5px;
    }

    .sys-bar {
        height: 100%;
        border-radius: 5px;
        background: #34a853;
        transition: width .6s ease, background .3s;
    }

    .sys-bar-blue {
        background: #1a73e8;
    }

    .sys-metric-sub {
        font-size: 11px;
        color: #aaa;
    }

    .sys-chips {
        display: flex;
        gap: 12px;
        flex-wrap: wrap;
        margin-top: 4px;
    }

    .sys-chip {
        background: #f8f9fa;
        border-radius: 11px;
        padding: 11px 16px;
        flex: 1;
        min-width: 0;
        display: flex;
        flex-direction: column;
        gap: 3px;
    }

    .sys-chip .sc-icon {
        font-size: 14px;
        color: #ccc;
    }

    .sys-chip .sc-lbl {
        font-size: 11px;
        color: #999;
    }

    .sys-chip .sc-val {
        font-size: 16px;
        font-weight: 800;
        color: #222;
    }

    /* ---- Trend chart panel ---- */
    .trend-header-info {
        display: flex;
        align-items: center;
        gap: 18px;
    }

    .trend-legend {
        display: flex;
        gap: 14px;
    }

    .trend-leg-item {
        display: flex;
        align-items: center;
        gap: 5px;
        font-size: 12px;
        color: #666;
        font-weight: 500;
    }

    .trend-leg-dot {
        width: 10px;
        height: 10px;
        border-radius: 50%;
        flex-shrink: 0;
    }

    .trend-stat-chips {
        display: flex;
        gap: 8px;
    }

    .trend-stat-chip {
        background: #f0f7ff;
        border-radius: 8px;
        padding: 3px 10px;
        font-size: 12px;
        color: #1a73e8;
        font-weight: 700;
    }

    .trend-stat-chip.green {
        background: #e6f4ea;
        color: #1e7e34;
    }

    #trendEmpty {
        text-align: center;
        padding: 40px 0;
        color: #ccc;
        font-size: 13px;
    }
</style>

<div class="app-main__outer" style="overflow-x:hidden;min-width:0;">
    <div class="app-main__inner" style="min-width:0;">
        <div class="dash-wrap">

            <!-- Header -->
            <div style="display:flex;align-items:center;justify-content:space-between;margin-bottom:20px;">
                <div>
                    <div style="font-size:20px;font-weight:800;color:#222;">Dashboard Quản trị</div>
                    <div style="font-size:12px;color:#999;margin-top:2px;">Cập nhật mỗi 30 giây &nbsp;|&nbsp; Hôm nay:
                        @DateTime.Now.ToString("dd/MM/yyyy")</div>
                    </div>
                    <div class="refresh-badge">
                        <div id="refresh-dot"></div>
                        <span id="refresh-text">Đang chờ...</span>
                    </div>
                </div>

                <!-- Stat cards -->
                <div class="stat-grid" id="stat-grid">
                    <div class="stat-card">
                        <div class="stat-icon blue"><i class="fa fa-users"></i></div>
                        <div>
                            <div class="stat-num" id="s-online">@Model.OnlineCount</div>
                            <div class="stat-label">Đang online (5 phút qua)</div>
                        </div>
                    </div>
                    <div class="stat-card">
                        <div class="stat-icon green"><i class="fa fa-pencil-square-o"></i></div>
                        <div>
                            <div class="stat-num" id="s-exam">@Model.ExamCount</div>
                            <div class="stat-label">Đang thi</div>
                        </div>
                    </div>
                    <div class="stat-card">
                        <div class="stat-icon orange"><i class="fa fa-sign-in"></i></div>
                        <div>
                            <div class="stat-num" id="s-today">@Model.TodayLogins</div>
                            <div class="stat-label">Lượt đăng nhập hôm nay</div>
                        </div>
                    </div>
                    <div class="stat-card">
                        <div class="stat-icon purple"><i class="fa fa-bar-chart"></i></div>
                        <div>
                            <div class="stat-num" id="s-total">@Model.TotalLogins</div>
                            <div class="stat-label">Tổng lượt đăng nhập</div>
                        </div>
                    </div>
                </div>

                <!-- Trend truy cập -->
                <div class="panel" style="margin-bottom:16px;">
                    <div class="panel-head">
                        <div class="trend-header-info">
                            <span>
                                <i class="fa fa-line-chart" style="margin-right:7px;color:#1a73e8;"></i>
                                Xu hướng truy cập (30 phút gần nhất)
                            </span>
                            <div class="trend-legend">
                                <div class="trend-leg-item">
                                    <div class="trend-leg-dot" style="background:#1a73e8;"></div>
                                    Online
                                </div>
                                <div class="trend-leg-item">
                                    <div class="trend-leg-dot" style="background:#34a853;"></div>
                                    Đang thi
                                </div>
                            </div>
                        </div>
                        <div class="trend-stat-chips">
                            <div class="trend-stat-chip" id="trend-peak-online">Đỉnh: --</div>
                            <div class="trend-stat-chip green" id="trend-peak-exam">Đỉnh thi: --</div>
                        </div>
                    </div>
                    <div class="panel-body" style="position:relative;height:110px;overflow:hidden;">
                        <div id="trendEmpty">Chưa có dữ liệu — biểu đồ sẽ tự cập nhật mỗi 30 giây</div>
                        <canvas id="trendChart" style="display:none;max-height:110px;"></canvas>
                    </div>
                </div>

                <!-- Chart + Table -->
                <div class="dash-row">

                    <!-- Bar chart theo giờ -->
                    <div class="panel">
                        <div class="panel-head">
                            <span><i class="fa fa-clock-o" style="margin-right:7px;color:#1a73e8;"></i>Lượt đăng nhập theo
                                giờ hôm nay</span>
                            </div>
                            <div class="panel-body">
                                <canvas id="hourlyChart" height="220"></canvas>
                            </div>
                        </div>

                        <!-- Danh sách online -->
                        <div class="panel">
                            <div class="panel-head">
                                <span><i class="fa fa-circle" style="margin-right:7px;color:#34a853;font-size:10px;"></i>Người
                                    đang online</span>
                                    <span style="font-size:12px;color:#888;font-weight:400;"
                                          id="online-count-label">@Model.OnlineCount người</span>
                                </div>
                                <div class="panel-body" style="padding:0;max-height:380px;overflow-y:auto;">
                                    <div id="online-table-wrap">
                                        @if (Model.OnlineUsers.Any())
                                        {
                                            <table class="dash-table">
                                                <thead>
                                                    <tr>
                                                        <th>Họ tên</th>
                                                        <th>Mã NV</th>
                                                        <th>Phòng ban</th>
                                                        <th>Hoạt động</th>
                                                    </tr>
                                                </thead>
                                                <tbody>
                                                    @foreach (var u in Model.OnlineUsers)
                                                    {
                                                        <tr>
                                                            <td>
                                                                <span class="badge-online"></span>
                                                                &nbsp;@u.HoTen
                                                            </td>
                                                            <td style="color:#888;">@u.MaNV</td>
                                                            <td>@u.PhongBan</td>
                                                            <td style="color:#aaa;font-size:11px;">@u.LastActive</td>
                                                        </tr>
                                                    }
                                                </tbody>
                                            </table>
                                        }
                                        else
                                        {
                                            <div class="empty-state">Chưa có người dùng online</div>
                                        }
                                    </div>
                                </div>
                            </div>
                        </div>

                        <!-- RabbitMQ Monitor -->
                        <div class="panel" style="margin-top:16px;">
                            <div class="panel-head">
                                <span><i class="fa fa-exchange" style="margin-right:7px;color:#e65100;"></i>RabbitMQ — Toàn vẹn dữ liệu bài thi</span>
                                <div style="display:flex;align-items:center;gap:10px;flex-wrap:wrap;">
                                    <span id="mq-status-badge" style="font-size:11px;padding:3px 10px;border-radius:20px;font-weight:700;background:#eee;color:#888;">Đang tải...</span>
                                    <button onclick="resetMqStats()" style="font-size:11px;padding:3px 10px;border-radius:6px;border:1px solid #ddd;background:#fff;cursor:pointer;color:#666;" title="Xóa counter về 0 sau mỗi kỳ thi">Reset counters</button>
                                    <span class="refresh-badge">
                                        <div id="mq-dot" style="width:7px;height:7px;border-radius:50%;background:#bbb;transition:background .3s;flex-shrink:0;"></div>
                                        <span id="mq-updated">Đang tải...</span>
                                    </span>
                                </div>
                            </div>
                            <div class="panel-body">
                                <!-- 4 mini stat cards -->
                                <div style="display:grid;grid-template-columns:repeat(4,1fr);gap:10px;margin-bottom:14px;">
                                    <div style="background:#e8f0fe;border-radius:10px;padding:12px 14px;display:flex;align-items:center;gap:10px;">
                                        <div style="font-size:20px;color:#1a73e8;">&#8679;</div>
                                        <div>
                                            <div id="mq-published" style="font-size:22px;font-weight:800;color:#222;line-height:1;">--</div>
                                            <div style="font-size:11px;color:#666;margin-top:2px;">Đã gửi vào queue</div>
                                        </div>
                                    </div>
                                    <div style="background:#e6f4ea;border-radius:10px;padding:12px 14px;display:flex;align-items:center;gap:10px;">
                                        <div style="font-size:20px;color:#1e7e34;">&#10003;</div>
                                        <div>
                                            <div id="mq-processed" style="font-size:22px;font-weight:800;color:#222;line-height:1;">--</div>
                                            <div style="font-size:11px;color:#666;margin-top:2px;">Đã lưu DB thành công</div>
                                        </div>
                                    </div>
                                    <div style="background:#fef3e2;border-radius:10px;padding:12px 14px;display:flex;align-items:center;gap:10px;">
                                        <div style="font-size:20px;color:#e65100;">&#8987;</div>
                                        <div>
                                            <div id="mq-pending" style="font-size:22px;font-weight:800;color:#222;line-height:1;">--</div>
                                            <div style="font-size:11px;color:#666;margin-top:2px;">Chờ xử lý (counter)</div>
                                        </div>
                                    </div>
                                    <div style="background:#fce8e6;border-radius:10px;padding:12px 14px;display:flex;align-items:center;gap:10px;">
                                        <div style="font-size:20px;color:#d32f2f;">&#10007;</div>
                                        <div>
                                            <div id="mq-failed" style="font-size:22px;font-weight:800;color:#222;line-height:1;">--</div>
                                            <div style="font-size:11px;color:#666;margin-top:2px;">Lỗi (dead-letter)</div>
                                        </div>
                                    </div>
                                </div>
                                <!-- Queue depth + rate info -->
                                <div id="mq-queue-row" style="display:flex;gap:10px;flex-wrap:wrap;font-size:12px;color:#666;align-items:center;">
                                    <span>Queue depth: <b id="mq-qdepth" style="color:#333;">--</b></span>
                                    <span style="color:#ddd;">|</span>
                                    <span>Sẵn sàng: <b id="mq-qready" style="color:#333;">--</b></span>
                                    <span style="color:#ddd;">|</span>
                                    <span>Đang xử lý: <b id="mq-qunacked" style="color:#333;">--</b></span>
                                    <span style="color:#ddd;">|</span>
                                    <span>Publish rate: <b id="mq-prate" style="color:#1a73e8;">--</b> msg/s</span>
                                    <span style="color:#ddd;">|</span>
                                    <span>Consume rate: <b id="mq-drate" style="color:#1e7e34;">--</b> msg/s</span>
                                </div>
                                <div id="mq-integrity-warn" style="display:none;margin-top:10px;padding:8px 12px;background:#fff3e0;border-left:3px solid #f57c00;border-radius:4px;font-size:12px;color:#e65100;">
                                    &#9888; Counter Redis không khớp với queue depth RabbitMQ — có thể có message chưa được đếm (IIS restart, crash).
                                </div>
                                <div id="mq-mgmt-err" style="display:none;margin-top:8px;font-size:11px;color:#aaa;"></div>
                            </div>
                        </div>

                        <!-- System Performance -->
                        <div class="panel" style="margin-top:16px;">
                            <div class="panel-head">
                                <span>
                                    <i class="fa fa-server" style="margin-right:7px;color:#7b1fa2;"></i>
                                    Hiệu năng hệ thống (server process)
                                </span>
                                <span class="refresh-badge">
                                    <div id="sys-dot"
                                         style="width:7px;height:7px;border-radius:50%;background:#bbb;transition:background .3s;flex-shrink:0;">
                                    </div>
                                    <span id="sys-updated">Đang tải...</span>
                                </span>
                            </div>
                            <div class="panel-body">
                                <div class="sys-grid">
                                    <!-- CPU -->
                                    <div>
                                        <div class="sys-metric-hd">
                                            <span class="sys-metric-label"><i class="fa fa-microchip"
                                                                                  style="margin-right:5px;"></i>CPU (process)</span>
                                                <span class="sys-metric-val" id="sys-cpu">--%</span>
                                            </div>
                                            <div class="sys-bar-track">
                                                <div class="sys-bar" id="sys-cpu-bar" style="width:0%"></div>
                                            </div>
                                            <div class="sys-metric-sub" id="sys-cpu-sub">-- lõi logic</div>
                                        </div>
                                        <!-- RAM -->
                                        <div>
                                            <div class="sys-metric-hd">
                                                <span class="sys-metric-label"><i class="fa fa-hdd-o" style="margin-right:5px;"></i>RAM
                                                    (Working Set)</span>
                                                    <span class="sys-metric-val" id="sys-ram">-- MB</span>
                                                </div>
                                                <div class="sys-bar-track">
                                                    <div class="sys-bar sys-bar-blue" id="sys-ram-bar" style="width:0%"></div>
                                                </div>
                                                <div class="sys-metric-sub" id="sys-ram-sub">Tổng RAM khả dụng: -- MB</div>
                                            </div>
                                        </div>
                                        <!-- Chips -->
                                        <div class="sys-chips">
                                            <div class="sys-chip">
                                                <span class="sc-icon"><i class="fa fa-clock-o"></i></span>
                                                <span class="sc-lbl">Uptime</span>
                                                <span class="sc-val" id="sys-uptime">--</span>
                                            </div>
                                            <div class="sys-chip">
                                                <span class="sc-icon"><i class="fa fa-tasks"></i></span>
                                                <span class="sc-lbl">Threads</span>
                                                <span class="sc-val" id="sys-threads">--</span>
                                            </div>
                                            <div class="sys-chip">
                                                <span class="sc-icon"><i class="fa fa-database"></i></span>
                                                <span class="sc-lbl">GC Heap</span>
                                                <span class="sc-val" id="sys-gc">-- MB</span>
                                            </div>
                                            <div class="sys-chip">
                                                <span class="sc-icon"><i class="fa fa-microchip"></i></span>
                                                <span class="sc-lbl">CPU Cores</span>
                                                <span class="sc-val" id="sys-cores">--</span>
                                            </div>
                                        </div>
                                    </div>
                                </div>

                            </div>
                        </div>
                    </div>

                    <script src="https://cdn.jsdelivr.net/npm/chart.js@4.4.0/dist/chart.umd.min.js"></script>
                    <script>
                        // ----- Biểu đồ theo giờ -----
                        var hourlyData = @Html.Raw(System.Text.Json.JsonSerializer.Serialize(Model.HourlyLogins));
                        var hourLabels = Array.from({ length: 24 }, function (_, i) { return i.toString().padStart(2, '0') + 'h'; });
                        var currentHour = new Date().getHours();

                        var barColors = hourLabels.map(function (_, i) {
                        return i === currentHour ? '#1a73e8' : '#c5d9fb';
                        });

                        var ctx = document.getElementById('hourlyChart').getContext('2d');
                        var chart = new Chart(ctx, {
                        type: 'bar',
                        data: {
                        labels: hourLabels,
                        datasets: [{
                        data: hourlyData,
                        backgroundColor: barColors,
                        borderRadius: 4,
                        borderSkipped: false,
                        }]
                        },
                        options: {
                        plugins: { legend: { display: false } },
                        scales: {
                        y: { beginAtZero: true, ticks: { stepSize: 1, font: { size: 11 } }, grid: { color: '#f0f0f0' } },
                        x: { ticks: { font: { size: 10 } }, grid: { display: false } }
                        },
                        animation: { duration: 400 }
                        }
                        });

                        // ----- Auto-refresh 30 giây -----
                        var refreshDot = document.getElementById('refresh-dot');
                        var refreshText = document.getElementById('refresh-text');
                        var countdown = 30;

                        function tick() {
                        countdown--;
                        refreshText.textContent = 'Làm mới sau ' + countdown + 's';
                        if (countdown <= 0) { countdown = 30; refreshData(); }
                        }

                        async function refreshData() {
                        refreshDot.classList.add('active');
                        refreshText.textContent = 'Đang cập nhật...';
                        try {
                        var res = await fetch('/AdminDashboard/Data');
                        var data = await res.json();

                        document.getElementById('s-online').textContent = data.OnlineCount;
                        document.getElementById('s-exam').textContent = data.ExamCount;
                        document.getElementById('s-today').textContent = data.TodayLogins;
                        document.getElementById('s-total').textContent = data.TotalLogins;
                        document.getElementById('online-count-label').textContent = data.OnlineCount + ' người';

                        chart.data.datasets[0].data = data.HourlyLogins;
                        currentHour = new Date().getHours();
                        chart.data.datasets[0].backgroundColor = data.HourlyLogins.map(function (_, i) {
                        return i === currentHour ? '#1a73e8' : '#c5d9fb';
                        });
                        chart.update('none');

                        var wrap = document.getElementById('online-table-wrap');
                        if (!data.OnlineUsers || data.OnlineUsers.length === 0) {
                        wrap.innerHTML = '<div class="empty-state">Chưa có người dùng online</div>';
                        } else {
                        var rows = data.OnlineUsers.map(function (u) {
                        return '<tr>'
                        + '<td><span class="badge-online"></span>&nbsp;' + u.HoTen + '</td>'
                        + '<td style="color:#888;">' + u.MaNV + '</td>'
                        + '<td>' + u.PhongBan + '</td>'
                        + '<td style="color:#aaa;font-size:11px;">' + u.LastActive + '</td>'
                        + '</tr>';
                        }).join('');
                        wrap.innerHTML = '<table class="dash-table"><thead><tr>'
                        + '<th>Họ tên</th><th>Mã NV</th><th>Phòng ban</th><th>Hoạt động</th>'
                        + '</tr></thead><tbody>' + rows + '</tbody></table>';
                        }

                        if (data.TrendPoints && data.TrendPoints.length > 0) {
                        applyTrendData(data.TrendPoints);
                        }
                        } catch (e) { }
                        setTimeout(function () { refreshDot.classList.remove('active'); }, 500);
                        refreshText.textContent = 'Làm mới sau 30s';
                        }

                        setInterval(tick, 1000);
                        tick();

                        // ----- Trend chart -----
                        var trendInitData = @Html.Raw(System.Text.Json.JsonSerializer.Serialize(Model.TrendPoints));

                        function fmtTime(ms) {
                        var d = new Date(ms);
                        return d.getHours().toString().padStart(2, '0') + ':'
                        + d.getMinutes().toString().padStart(2, '0') + ':'
                        + d.getSeconds().toString().padStart(2, '0');
                        }

                        var trendCtx = document.getElementById('trendChart').getContext('2d');
                        var gradBlue = trendCtx.createLinearGradient(0, 0, 0, 240);
                        gradBlue.addColorStop(0, 'rgba(26,115,232,0.25)');
                        gradBlue.addColorStop(1, 'rgba(26,115,232,0)');
                        var gradGreen = trendCtx.createLinearGradient(0, 0, 0, 240);
                        gradGreen.addColorStop(0, 'rgba(52,168,83,0.18)');
                        gradGreen.addColorStop(1, 'rgba(52,168,83,0)');

                        var trendChart = new Chart(trendCtx, {
                        type: 'line',
                        data: {
                        labels: [],
                        datasets: [
                        {
                        label: 'Online',
                        data: [],
                        borderColor: '#1a73e8',
                        backgroundColor: gradBlue,
                        borderWidth: 2,
                        pointRadius: 3,
                        pointHoverRadius: 5,
                        tension: 0.4,
                        fill: true,
                        },
                        {
                        label: 'Đang thi',
                        data: [],
                        borderColor: '#34a853',
                        backgroundColor: gradGreen,
                        borderWidth: 2,
                        pointRadius: 3,
                        pointHoverRadius: 5,
                        tension: 0.4,
                        fill: true,
                        borderDash: [5, 3],
                        }
                        ]
                        },
                        options: {
                        responsive: true,
                        maintainAspectRatio: false,
                        interaction: { mode: 'index', intersect: false },
                        plugins: {
                        legend: { display: false },
                        tooltip: {
                        callbacks: {
                        title: function (items) { return items[0].label; },
                        }
                        }
                        },
                        scales: {
                        x: {
                        ticks: { font: { size: 10 }, maxTicksLimit: 10 },
                        grid: { display: false }
                        },
                        y: {
                        beginAtZero: true,
                        ticks: { stepSize: 1, font: { size: 11 } },
                        grid: { color: '#f5f5f5' }
                        }
                        },
                        animation: { duration: 300 }
                        }
                        });

                        function applyTrendData(points) {
                        if (!points || points.length === 0) {
                        document.getElementById('trendEmpty').style.display = 'block';
                        document.getElementById('trendChart').style.display = 'none';
                        return;
                        }
                        document.getElementById('trendEmpty').style.display = 'none';
                        document.getElementById('trendChart').style.display = '';

                        trendChart.data.labels = points.map(function (p) { return fmtTime(p.T); });
                        trendChart.data.datasets[0].data = points.map(function (p) { return p.O; });
                        trendChart.data.datasets[1].data = points.map(function (p) { return p.E; });
                        trendChart.update('none');

                        var peakO = Math.max.apply(null, points.map(function (p) { return p.O; }));
                        var peakE = Math.max.apply(null, points.map(function (p) { return p.E; }));
                        document.getElementById('trend-peak-online').textContent = 'Đỉnh: ' + peakO + ' người';
                        document.getElementById('trend-peak-exam').textContent = 'Đỉnh thi: ' + peakE;
                        }

                        applyTrendData(trendInitData);

                        // ----- System performance (refresh mỗi 5s) -----
                        var sysDot = document.getElementById('sys-dot');
                        var sysUpdated = document.getElementById('sys-updated');

                        async function refreshSys() {
                        sysDot.style.background = '#1a73e8';
                        try {
                        var r = await fetch('/AdminDashboard/SysInfo');
                        var d = await r.json();

                        // CPU
                        var cpuColor = d.CpuPct > 80 ? '#d32f2f' : d.CpuPct > 50 ? '#f57c00' : '#34a853';
                        document.getElementById('sys-cpu').textContent = d.CpuPct + '%';
                        document.getElementById('sys-cpu-bar').style.width = Math.min(d.CpuPct, 100) + '%';
                        document.getElementById('sys-cpu-bar').style.background = cpuColor;
                        document.getElementById('sys-cpu-sub').textContent = d.ProcessorCount + ' lõi logic';
                        document.getElementById('sys-cores').textContent = d.ProcessorCount;

                        // RAM
                        var ramPct = d.TotalRamMb > 0 ? Math.min(d.RamMb / d.TotalRamMb * 100, 100) : Math.min(d.RamMb / 2048 * 100, 100);
                        var ramColor = ramPct > 85 ? '#d32f2f' : ramPct > 60 ? '#f57c00' : '#1a73e8';
                        document.getElementById('sys-ram').textContent = d.RamMb + ' MB';
                        document.getElementById('sys-ram-bar').style.width = ramPct.toFixed(1) + '%';
                        document.getElementById('sys-ram-bar').style.background = ramColor;
                        document.getElementById('sys-ram-sub').textContent = d.TotalRamMb > 0
                        ? 'Tổng RAM khả dụng: ' + d.TotalRamMb + ' MB'
                        : 'GC heap: ' + d.GcMb + ' MB';

                        // Chips
                        document.getElementById('sys-uptime').textContent = d.Uptime;
                        document.getElementById('sys-threads').textContent = d.Threads;
                        document.getElementById('sys-gc').textContent = d.GcMb + ' MB';

                        var t = new Date();
                        sysUpdated.textContent = 'Cập nhật lúc '
                        + t.getHours().toString().padStart(2, '0') + ':'
                        + t.getMinutes().toString().padStart(2, '0') + ':'
                        + t.getSeconds().toString().padStart(2, '0');
                        sysDot.style.background = '#34a853';
                        } catch (e) {
                        sysDot.style.background = '#d32f2f';
                        sysUpdated.textContent = 'Lỗi kết nối';
                        }
                        }

                        refreshSys();
                        setInterval(refreshSys, 5000);

                        // ----- RabbitMQ Monitor (refresh mỗi 5s) -----
                        var mqDot     = document.getElementById('mq-dot');
                        var mqUpdated = document.getElementById('mq-updated');

                        var MQ_STATUS_STYLE = {
                            ok:      { bg: '#e6f4ea', color: '#1e7e34', text: '✓ Toàn vẹn' },
                            warning: { bg: '#fff3e0', color: '#e65100', text: '⏳ Đang xử lý' },
                            error:   { bg: '#fce8e6', color: '#d32f2f', text: '✗ Có lỗi' },
                            idle:    { bg: '#f0f0f0', color: '#888',    text: '— Chờ dữ liệu' },
                        };

                        async function refreshMqStats() {
                            mqDot.style.background = '#1a73e8';
                            try {
                                var r = await fetch('/AdminDashboard/RabbitStats');
                                var d = await r.json();

                                document.getElementById('mq-published').textContent  = d.Published.toLocaleString();
                                document.getElementById('mq-processed').textContent  = d.Processed.toLocaleString();
                                document.getElementById('mq-pending').textContent    = d.Pending.toLocaleString();
                                document.getElementById('mq-failed').textContent     = d.Failed.toLocaleString();

                                // Queue depth từ Management API
                                if (d.MgmtAvailable) {
                                    document.getElementById('mq-qdepth').textContent    = d.QueueMessages.toLocaleString();
                                    document.getElementById('mq-qready').textContent    = d.QueueReady.toLocaleString();
                                    document.getElementById('mq-qunacked').textContent  = d.QueueUnacked.toLocaleString();
                                    document.getElementById('mq-prate').textContent     = d.PublishRate !== null ? d.PublishRate : '0';
                                    document.getElementById('mq-drate').textContent     = d.DeliverRate !== null ? d.DeliverRate : '0';
                                    document.getElementById('mq-mgmt-err').style.display = 'none';
                                } else {
                                    document.getElementById('mq-qdepth').textContent   = 'N/A';
                                    document.getElementById('mq-qready').textContent   = 'N/A';
                                    document.getElementById('mq-qunacked').textContent = 'N/A';
                                    document.getElementById('mq-prate').textContent    = 'N/A';
                                    document.getElementById('mq-drate').textContent    = 'N/A';
                                    var errEl = document.getElementById('mq-mgmt-err');
                                    errEl.style.display = '';
                                    errEl.textContent = 'Management API không khả dụng: ' + d.MgmtError;
                                }

                                // Integrity warning
                                document.getElementById('mq-integrity-warn').style.display =
                                    d.MgmtAvailable && !d.IntegrityOk ? '' : 'none';

                                // Status badge
                                var st = MQ_STATUS_STYLE[d.Status] || MQ_STATUS_STYLE.idle;
                                var badge = document.getElementById('mq-status-badge');
                                badge.style.background = st.bg;
                                badge.style.color      = st.color;
                                badge.textContent       = st.text + ' — ' + d.StatusMsg;

                                // Failed highlight
                                document.getElementById('mq-failed').style.color = d.Failed > 0 ? '#d32f2f' : '#222';

                                var t = new Date();
                                mqUpdated.textContent = 'Cập nhật '
                                    + t.getHours().toString().padStart(2,'0') + ':'
                                    + t.getMinutes().toString().padStart(2,'0') + ':'
                                    + t.getSeconds().toString().padStart(2,'0');
                                mqDot.style.background = '#34a853';
                            } catch (e) {
                                mqDot.style.background = '#d32f2f';
                                mqUpdated.textContent = 'Lỗi kết nối';
                            }
                        }

                        async function resetMqStats() {
                            if (!confirm('Reset toàn bộ counter RabbitMQ về 0?\n\nChỉ làm sau khi kỳ thi kết thúc để bắt đầu theo dõi phiên mới.')) return;
                            try {
                                await fetch('/AdminDashboard/ResetMqStats', { method: 'POST' });
                                await refreshMqStats();
                            } catch (e) { alert('Lỗi reset counter'); }
                        }

                        refreshMqStats();
                        setInterval(refreshMqStats, 5000);
                    </script>
