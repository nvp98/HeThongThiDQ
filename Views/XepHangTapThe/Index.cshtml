@{
    ViewBag.Title = "Xếp hạng tập thể";
    Layout = "~/Views/Shared/_Layout.cshtml";
}

<div class="app-main__outer">
<div class="app-main__inner pb-4">

<!-- ══ BANNER ══════════════════════════════════════════════════════════════ -->
<div class="rk-banner rk-banner-team">
    <div class="rk-banner-left">
        <div class="rk-banner-icon"><i class="fa fa-flag"></i></div>
        <div>
            <div class="rk-banner-title">XẾP HẠNG TẬP THỂ</div>
            <div class="rk-banner-sub">Tỉ lệ CBCNV hoàn thành ôn luyện</div>
        </div>
    </div>
    <a asp-controller="XepHangCaNhan" asp-action="Index" class="rk-switch-btn">
        <i class="fa fa-user"></i>&nbsp; Xem xếp hạng cá nhân &rarr;
    </a>
</div>

<!-- ══ STAT CARDS ══════════════════════════════════════════════════════════ -->
<div class="rk-stat-cards mb-4">
    <div class="rk-sc rk-sc-teal">
        <div class="rk-sc-ico"><i class="fa fa-building"></i></div>
        <div><div class="rk-sc-num" id="sDonVi">--</div><div class="rk-sc-lbl">Đơn vị tham gia</div></div>
    </div>
    <div class="rk-sc rk-sc-blue">
        <div class="rk-sc-ico"><i class="fa fa-users"></i></div>
        <div><div class="rk-sc-num" id="sDangKy">--</div><div class="rk-sc-lbl">CBCNV đăng ký</div></div>
    </div>
    <div class="rk-sc rk-sc-green">
        <div class="rk-sc-ico"><i class="fa fa-check-circle"></i></div>
        <div><div class="rk-sc-num" id="sHT">--</div><div class="rk-sc-lbl">CBCNV hoàn thành</div></div>
    </div>
</div>

<!-- ══ PODIUM ══════════════════════════════════════════════════════════════ -->
<div id="podiumWrap" class="mb-4"></div>

<!-- ══ BIỂU ĐỒ ════════════════════════════════════════════════════════════ -->
<div class="rk-card mb-4" id="chartCard" style="display:none">
    <div class="rk-card-hd">
        <span><i class="fa fa-bar-chart"></i>&nbsp; Biểu đồ tỉ lệ hoàn thành theo đơn vị</span>
        <div style="display:flex;align-items:center;gap:12px;font-size:.75rem;color:#6b7280">
            <span><span style="display:inline-block;width:10px;height:10px;border-radius:2px;background:#22c55e;margin-right:4px"></span>≥ 80%</span>
            <span><span style="display:inline-block;width:10px;height:10px;border-radius:2px;background:#f59e0b;margin-right:4px"></span>≥ 50%</span>
            <span><span style="display:inline-block;width:10px;height:10px;border-radius:2px;background:#ef4444;margin-right:4px"></span>&lt; 50%</span>
        </div>
    </div>
    <div style="padding:20px 24px 24px">
        <div id="chartWrap" style="position:relative">
            <canvas id="chartTapThe"></canvas>
        </div>
    </div>
</div>

<!-- ══ FILTER ══════════════════════════════════════════════════════════════ -->
<div class="rk-filter-card mb-4">
    <div class="rk-filter-hd"><i class="fa fa-filter"></i> Bộ lọc dữ liệu</div>
    <div class="rk-filter-row">
        <div class="rk-search-box">
            <i class="fa fa-search"></i>
            <input id="txtSearch" placeholder="Tìm tên phòng ban, đơn vị..." autocomplete="off" />
            <button id="btnClear" class="rk-clear-btn" style="display:none"><i class="fa fa-times"></i></button>
        </div>
        <div class="rk-filter-right">
            <span class="rk-count-badge" id="badgeTotal" style="display:none"></span>
            <button class="rk-btn-refresh" id="btnLoad"><i class="fa fa-refresh"></i> Làm mới</button>
        </div>
    </div>
</div>

<!-- ══ TABLE ═══════════════════════════════════════════════════════════════ -->
<div class="rk-card">
    <div class="rk-card-hd">
        <span><i class="fa fa-list-ol"></i>&nbsp; Bảng xếp hạng tập thể</span>
        <span id="badgeTotal2" class="rk-count-badge" style="display:none"></span>
    </div>
    <div class="table-responsive">
        <table class="rk-table">
            <thead>
                <tr>
                    <th style="width:56px" class="text-center">Hạng</th>
                    <th style="min-width:220px">Đơn vị / Phòng ban</th>
                    <th style="width:140px" class="text-center">Tổng CBCNV</th>
                    <th style="width:150px" class="text-center">Đã hoàn thành</th>
                    <th style="min-width:180px" class="text-center">Tỉ lệ hoàn thành</th>
                </tr>
            </thead>
            <tbody id="tblBody">
                <tr><td colspan="5" class="rk-loading"><i class="fa fa-spinner fa-spin"></i> Đang tải dữ liệu...</td></tr>
            </tbody>
        </table>
    </div>
</div>

</div>
<div class="app-wrapper-footer"><div class="app-footer"><div class="app-footer__inner"></div></div></div>
</div>

@Html.Partial("~/Views/XepHang/_XepHangStyle.cshtml")
<style>
.rk-table { width:100%; border-collapse:collapse; font-size:.875rem; }
.rk-table thead th {
    padding:11px 14px; background:#0e7490; color:#fff;
    font-size:.71rem; font-weight:700; text-transform:uppercase;
    letter-spacing:.6px; white-space:nowrap; border:none;
}
.rk-table tbody tr { border-bottom:1px solid #f1f5f9; transition:background .12s; }
.rk-table tbody tr:hover td { background:#f0fdfa !important; }
.rk-table tbody td { padding:12px 14px; vertical-align:middle; }
.rk-table tr.rk-gold   td { background:#fffbeb; }
.rk-table tr.rk-silver td { background:#f8fafc; }
.rk-table tr.rk-bronze td { background:#fff7f0; }
.rk-unit-cell { display:flex; align-items:center; gap:12px; }
.rk-unit-icon {
    width:40px; height:40px; border-radius:10px; flex-shrink:0;
    display:flex; align-items:center; justify-content:center; color:#fff; font-size:.95rem;
}
.rk-unit-name { font-weight:700; font-size:.9rem; color:#111; }
.rk-unit-sub  { font-size:.73rem; color:#6b7280; margin-top:1px; }
.rk-nv-passed { color:#16a34a; font-weight:700; font-size:.95rem; }
.rk-nv-total  { color:#6b7280; font-size:.78rem; }
.rk-rate-col  { display:flex; flex-direction:column; gap:3px; }
.rk-rate-bar  { height:8px; border-radius:4px; background:#e5e7eb; overflow:hidden; }
.rk-rate-fill { height:100%; border-radius:4px; transition:width .6s; }
</style>

<script src="https://cdn.jsdelivr.net/npm/chart.js@4.4.4/dist/chart.umd.min.js"></script>
<script>
var _tC=['#0e7490','#1565C0','#6d28d9','#0d9488','#059669','#d97706','#dc2626','#7c3aed'];
function teamColor(n){ var s=0; for(var i=0;i<(n||'').length;i++) s+=n.charCodeAt(i); return _tC[s%_tC.length]; }
function rateClr(r){ return r>=80?'#22c55e':r>=50?'#f59e0b':'#ef4444'; }

var _chart=null;

function renderChart(data) {
    if (!data||!data.length) { $('#chartCard').hide(); return; }
    var sorted = data.slice().sort(function(a,b){ return a.Rank-b.Rank; });
    var labels  = sorted.map(function(d){
        var badge = d.Rank<=3?['🥇','🥈','🥉'][d.Rank-1]:'#'+d.Rank;
        return badge+' '+d.PhongBan;
    });
    var values    = sorted.map(function(d){ return d.TiLeHoanThanh; });
    var bgColors  = sorted.map(function(d){
        var r=d.TiLeHoanThanh||0;
        return r>=80?'rgba(34,197,94,.82)':r>=50?'rgba(245,158,11,.82)':'rgba(239,68,68,.82)';
    });
    var brdColors = sorted.map(function(d){ return rateClr(d.TiLeHoanThanh||0); });

    var canvasH = Math.max(260, sorted.length*38);
    $('#chartWrap').css('height', canvasH+'px');
    if (_chart) { _chart.destroy(); _chart=null; }

    var ctx = document.getElementById('chartTapThe').getContext('2d');
    _chart = new Chart(ctx, {
        type: 'bar',
        data: {
            labels: labels,
            datasets: [{
                label: 'Tỉ lệ hoàn thành (%)',
                data: values,
                backgroundColor: bgColors,
                borderColor: brdColors,
                borderWidth: 1.5,
                borderRadius: 5,
                borderSkipped: false
            }]
        },
        options: {
            indexAxis: 'y',
            responsive: true,
            maintainAspectRatio: false,
            animation: { duration: 500 },
            plugins: {
                legend: { display: false },
                tooltip: {
                    backgroundColor: '#1e2a4a',
                    titleColor: '#fbbf24',
                    bodyColor: '#e5e7eb',
                    padding: 12,
                    cornerRadius: 8,
                    callbacks: {
                        title: function(items) {
                            var d=sorted[items[0].dataIndex];
                            return 'Hạng '+d.Rank+' — '+d.PhongBan;
                        },
                        label: function(item) {
                            var d=sorted[item.dataIndex];
                            return [
                                '  Tỉ lệ hoàn thành : '+d.TiLeHoanThanh+'%',
                                '  Đã hoàn thành    : '+d.SoHoanThanh+'/'+d.TongDangKy+' người'
                            ];
                        }
                    }
                }
            },
            scales: {
                x: {
                    beginAtZero: true, max: 100,
                    grid: { color: '#f1f5f9' },
                    border: { display: false },
                    ticks: { color: '#6b7280', font: { size: 12 }, callback: function(v){ return v+'%'; } }
                },
                y: {
                    grid: { display: false },
                    border: { display: false },
                    ticks: { color: '#374151', font: { size: 12.5 } }
                }
            }
        }
    });
    $('#chartCard').show();
}

function loadStats(){
    $.get('/XepHangTapThe/GetStats', function(d){
        animCount('sDonVi',  d.TongDonVi);
        animCount('sDangKy', d.TongDangKy);
        animCount('sHT',     d.TongHoanThanh);
    });
}

function load(){
    var p={ search: $('#txtSearch').val() };
    $('#tblBody').html('<tr><td colspan="5" class="rk-loading"><i class="fa fa-spinner fa-spin"></i> Đang tải...</td></tr>');
    $('#podiumWrap').empty();
    $.get('/XepHangTapThe/GetData', p, function(data){
        if(!Array.isArray(data)||!data.length){
            $('#tblBody').html('<tr><td colspan="5" class="rk-loading"><i class="fa fa-inbox fa-lg"></i><br>Không có dữ liệu phù hợp</td></tr>');
            $('#badgeTotal,#badgeTotal2').hide();
            $('#chartCard').hide();
            if(_chart){_chart.destroy();_chart=null;}
            return;
        }
        var label=fmt(data.length)+' đơn vị';
        $('#badgeTotal').text(label).show();
        $('#badgeTotal2').text(label).show();

        renderPodium(data);
        renderChart(data);

        var rows='';
        data.forEach(function(d){
            var cls=d.Rank===1?'rk-gold':d.Rank===2?'rk-silver':d.Rank===3?'rk-bronze':'';
            var rc=rateClr(d.TiLeHoanThanh||0);
            var tc=teamColor(d.PhongBan);
            rows+='<tr class="'+cls+'">'+
                '<td class="text-center">'+rankBadge(d.Rank)+'</td>'+
                '<td><div class="rk-unit-cell">'+
                    '<div class="rk-unit-icon" style="background:'+tc+'"><i class="fa fa-building"></i></div>'+
                    '<div><div class="rk-unit-name">'+(d.PhongBan||'')+'</div>'+
                    '<div class="rk-unit-sub">'+d.TongDangKy+' người đăng ký &bull; '+d.SoHoanThanh+' người hoàn thành</div></div></div></td>'+
                '<td class="text-center"><strong style="font-size:.95rem">'+d.TongDangKy+'</strong></td>'+
                '<td class="text-center"><span class="rk-nv-passed">'+d.SoHoanThanh+'</span><div class="rk-nv-total">/'+d.TongDangKy+' người</div></td>'+
                '<td>'+
                    '<div class="rk-rate-col">'+
                    '<div class="rk-rate-bar"><div class="rk-rate-fill" style="width:'+(d.TiLeHoanThanh||0)+'%;background:'+rc+'"></div></div>'+
                    '<div style="display:flex;justify-content:space-between;font-size:.72rem">'+
                        '<span style="font-weight:700;color:'+rc+'">'+(d.TiLeHoanThanh||0)+'%</span>'+
                        '<span style="color:#9ca3af">'+d.SoHoanThanh+'/'+d.TongDangKy+'</span>'+
                    '</div></div>'+
                '</td>'+
                '</tr>';
        });
        $('#tblBody').html(rows);
    });
}

function renderPodium(data){
    var icons={1:'🥇',2:'🥈',3:'🥉'};
    var html='<div class="rk-podium">';
    [2,1,3].forEach(function(r){
        var d=data.find(function(x){return x.Rank===r;}); if(!d) return;
        var tc=teamColor(d.PhongBan);
        html+='<div class="rk-pod rk-pod-'+r+'">'+
            '<div class="rk-pod-avatar" style="background:'+tc+';border-radius:12px">'+
                '<i class="fa fa-building" style="font-size:1.2rem"></i>'+
            '</div>'+
            '<div class="rk-pod-icon">'+icons[r]+'</div>'+
            '<div class="rk-pod-name">'+(d.PhongBan||'')+'</div>'+
            '<div class="rk-pod-unit">'+d.TongDangKy+' NV &bull; '+d.SoHoanThanh+' hoàn thành</div>'+
            '<div class="rk-pod-score">'+d.TiLeHoanThanh+'<span style="font-size:.7rem;color:#6b7280;font-weight:400">%</span></div>'+
            '<div class="rk-pod-base rk-base-'+r+'">Hạng '+r+'</div>'+
            '</div>';
    });
    html+='</div>';
    $('#podiumWrap').html(html);
}

$(document).ready(function(){
    loadStats(); load();
    $('#btnLoad').on('click',function(){ loadStats(); load(); });
    var st;
    $('#txtSearch').on('input',function(){
        $('#btnClear').toggle(!!$(this).val());
        clearTimeout(st); st=setTimeout(load,300);
    });
    $('#btnClear').on('click',function(){ $('#txtSearch').val('').trigger('input'); });
});
</script>
