@{
    ViewBag.Title = "Xếp hạng cá nhân";
    Layout = "~/Views/Shared/_Layout.cshtml";
}

<div class="app-main__outer">
<div class="app-main__inner pb-4">

<!-- ══ BANNER ══════════════════════════════════════════════════════════════ -->
<div class="rk-banner">
    <div class="rk-banner-left">
        <div class="rk-banner-icon"><i class="fa fa-trophy"></i></div>
        <div>
            <div class="rk-banner-title">XẾP HẠNG CÁ NHÂN</div>
            <div class="rk-banner-sub">Hội thi tìm hiểu về văn hóa lịch sử Q-Day 2026</div>
        </div>
    </div>
    <a asp-controller="XepHangTapThe" asp-action="Index" class="rk-switch-btn">
        <i class="fa fa-users"></i>&nbsp; Xem xếp hạng tập thể &rarr;
    </a>
</div>

<!-- ══ STAT CARDS ══════════════════════════════════════════════════════════ -->
<div class="rk-stat-cards mb-4">
    <div class="rk-sc rk-sc-blue">
        <div class="rk-sc-ico"><i class="fa fa-users"></i></div>
        <div><div class="rk-sc-num" id="sNguoi">--</div><div class="rk-sc-lbl">Thí sinh tham gia</div></div>
    </div>
    <div class="rk-sc rk-sc-teal">
        <div class="rk-sc-ico"><i class="fa fa-building"></i></div>
        <div><div class="rk-sc-num" id="sDonVi">--</div><div class="rk-sc-lbl">Đơn vị tham gia</div></div>
    </div>
    <div class="rk-sc rk-sc-amber">
        <div class="rk-sc-ico"><i class="fa fa-pencil-square-o"></i></div>
        <div><div class="rk-sc-num" id="sLuot">--</div><div class="rk-sc-lbl">Lượt tham gia thi</div></div>
    </div>
    <div class="rk-sc rk-sc-green">
        <div class="rk-sc-ico"><i class="fa fa-check-circle"></i></div>
        <div><div class="rk-sc-num" id="sHT">--</div><div class="rk-sc-lbl">Lượt hoàn thành</div></div>
    </div>
</div>

<!-- ══ PODIUM ══════════════════════════════════════════════════════════════ -->
<div id="podiumWrap" class="mb-4"></div>

<!-- ══ FILTER ══════════════════════════════════════════════════════════════ -->
<div class="rk-filter-card mb-4">
    <div class="rk-filter-hd"><i class="fa fa-filter"></i> Bộ lọc dữ liệu</div>
    <div class="rk-filter-row">
        <select id="filterLopHoc" class="rk-select">
            <option value="">📋 Tất cả khóa thi</option>
            @foreach (var lh in (ViewBag.LopHocList as IEnumerable<dynamic> ?? []))
            {
                <option value="@lh.Idlh">@lh.TenLh</option>
            }
        </select>
        <select id="filterPhongBan" class="rk-select">
            <option value="">🏢 Tất cả phòng ban</option>
            @foreach (var pb in (ViewBag.PhongBanList as IEnumerable<dynamic> ?? []))
            {
                <option value="@pb.IdphongBan">@pb.TenPhongBan</option>
            }
        </select>
        <div class="rk-search-box">
            <i class="fa fa-search"></i>
            <input id="txtSearch" placeholder="Tìm mã NV hoặc họ tên..." autocomplete="off" />
            <button id="btnClear" class="rk-clear-btn" style="display:none"><i class="fa fa-times"></i></button>
        </div>
        <div class="rk-filter-right">
            <span class="rk-count-badge" id="badgeTotal" style="display:none"></span>
            <button class="rk-btn-refresh" id="btnLoad"><i class="fa fa-refresh"></i> Làm mới</button>
        </div>
    </div>
</div>

<!-- ══ TABLE ═══════════════════════════════════════════════════════════════ -->
<div class="rk-card">
    <div class="rk-card-hd">
        <span><i class="fa fa-list-ol"></i>&nbsp; Bảng xếp hạng cá nhân</span>
        <span id="badgeTotal2" class="rk-count-badge" style="display:none"></span>
    </div>
    <div class="table-responsive">
        <table class="rk-table">
            <thead>
                <tr>
                    <th style="width:56px" class="text-center">Hạng</th>
                    <th style="min-width:220px">Thí sinh</th>
                    <th style="min-width:160px">Đơn vị / Phòng ban</th>
                    <th style="width:110px" class="text-center">Điểm cao nhất</th>
                    <th style="width:90px"  class="text-center">Điểm TB</th>
                    <th style="width:90px"  class="text-center">Số lần thi</th>
                    <th style="width:155px" class="text-center">Tỉ lệ đạt</th>
                    <th style="width:90px"  class="text-center">Thời gian</th>
                </tr>
            </thead>
            <tbody id="tblBody">
                <tr><td colspan="8" class="rk-loading"><i class="fa fa-spinner fa-spin"></i> Đang tải dữ liệu...</td></tr>
            </tbody>
        </table>
    </div>
</div>

</div>
<div class="app-wrapper-footer"><div class="app-footer"><div class="app-footer__inner"></div></div></div>
</div>

@Html.Partial("~/Views/XepHang/_XepHangStyle.cshtml")
<style>
.rk-table { width:100%; border-collapse:collapse; font-size:.875rem; }
.rk-table thead th {
    padding:11px 14px; background:#1e3a6e; color:#fff;
    font-size:.71rem; font-weight:700; text-transform:uppercase;
    letter-spacing:.6px; white-space:nowrap; border:none;
}
.rk-table tbody tr { border-bottom:1px solid #f1f5f9; transition:background .12s; }
.rk-table tbody tr:hover td { background:#f0f7ff !important; }
.rk-table tbody td { padding:11px 14px; vertical-align:middle; }
.rk-table tr.rk-gold   td { background:#fffbeb; }
.rk-table tr.rk-silver td { background:#f8fafc; }
.rk-table tr.rk-bronze td { background:#fff7f0; }

.rk-avatar {
    width:36px; height:36px; border-radius:50%; flex-shrink:0;
    display:inline-flex; align-items:center; justify-content:center;
    font-weight:700; font-size:.78rem; color:#fff;
}
.rk-name-cell { display:flex; align-items:center; gap:10px; }
.rk-name { font-weight:600; color:#111; font-size:.9rem; }
.rk-code { font-size:.74rem; color:#6b7280; }

.rk-score-big { font-size:1.2rem; font-weight:800; color:#1e3a6e; }
.rk-score-avg { font-size:.88rem; color:#6b7280; }

.rk-rate-col { display:flex; flex-direction:column; gap:3px; }
.rk-mini-bar { height:7px; border-radius:4px; background:#e5e7eb; overflow:hidden; }
.rk-mini-fill { height:100%; border-radius:4px; }
.rk-rate-nums { display:flex; justify-content:space-between; font-size:.72rem; }

.rk-time-badge {
    display:inline-block; background:#f1f5f9; border-radius:6px;
    padding:3px 9px; font-size:.78rem; font-family:monospace; color:#374151;
}
</style>

<script>
var _aC=['#6366f1','#8b5cf6','#06b6d4','#10b981','#f59e0b','#ef4444','#ec4899','#14b8a6','#f97316','#3b82f6'];
function avatarColor(n){ var s=0; for(var i=0;i<(n||'').length;i++) s+=n.charCodeAt(i); return _aC[s%_aC.length]; }
function initials(n){
    if(!n) return '?';
    var p=n.trim().split(' ');
    return p.length>=2?(p[0][0]+p[p.length-1][0]).toUpperCase():p[0].slice(0,2).toUpperCase();
}

function loadStats(){
    $.get('/XepHangCaNhan/GetStats',{idLH:$('#filterLopHoc').val()},function(d){
        animCount('sNguoi',d.tongNguoi);
        animCount('sDonVi',d.tongDonVi);
        animCount('sLuot', d.tongLuotThi);
        animCount('sHT',   d.tongHoanThanh);
    });
}

function load(){
    var p={idLH:$('#filterLopHoc').val(), idPB:$('#filterPhongBan').val(), search:$('#txtSearch').val()};
    $('#tblBody').html('<tr><td colspan="8" class="rk-loading"><i class="fa fa-spinner fa-spin"></i> Đang tải...</td></tr>');
    $('#podiumWrap').empty();
    $.get('/XepHangCaNhan/GetData',p,function(data){
        if(!Array.isArray(data)||!data.length){
            $('#tblBody').html('<tr><td colspan="8" class="rk-loading"><i class="fa fa-inbox fa-lg"></i><br>Không có dữ liệu phù hợp</td></tr>');
            $('#badgeTotal,#badgeTotal2').hide(); return;
        }
        var label=fmt(data.length)+' thí sinh';
        $('#badgeTotal').text(label).show();
        $('#badgeTotal2').text(label).show();

        renderPodium(data);
        var rows='';
        data.forEach(function(d){
            var cls=d.rank===1?'rk-gold':d.rank===2?'rk-silver':d.rank===3?'rk-bronze':'';
            var bc=rateColor(d.tiLeDat||0);
            var av=avatarColor(d.hoTen);
            rows+='<tr class="'+cls+'">'+
                '<td class="text-center">'+rankBadge(d.rank)+'</td>'+
                '<td><div class="rk-name-cell">'+
                    '<div class="rk-avatar" style="background:'+av+'">'+initials(d.hoTen)+'</div>'+
                    '<div><div class="rk-name">'+(d.hoTen||'')+'</div>'+
                    '<div class="rk-code">'+(d.maNv||'')+'</div></div></div></td>'+
                '<td><span style="font-size:.82rem;color:#6b7280">'+(d.phongBan||'—')+'</span></td>'+
                '<td class="text-center"><span class="rk-score-big">'+d.diemCaoNhat+'</span></td>'+
                '<td class="text-center"><span class="rk-score-avg">'+d.diemTrungBinh+'</span></td>'+
                '<td class="text-center"><span class="badge badge-light" style="font-size:.82rem">'+d.soLanThi+' lần</span></td>'+
                '<td>'+
                    '<div class="rk-rate-col">'+
                    '<div class="rk-mini-bar"><div class="rk-mini-fill" style="width:'+(d.tiLeDat||0)+'%;background:'+bc+'"></div></div>'+
                    '<div class="rk-rate-nums">'+
                        '<span style="font-weight:700;color:'+bc+'">'+(d.tiLeDat||0)+'%</span>'+
                        '<span style="color:#9ca3af">'+d.soLanDat+'/'+d.soLanThi+' lần đạt</span>'+
                    '</div></div>'+
                '</td>'+
                '<td class="text-center"><span class="rk-time-badge">'+(d.thoiGian||'--')+'</span></td>'+
                '</tr>';
        });
        $('#tblBody').html(rows);
    });
}

function renderPodium(data){
    var icons={1:'🥇',2:'🥈',3:'🥉'};
    var html='<div class="rk-podium">';
    [2,1,3].forEach(function(r){
        var d=data.find(function(x){return x.rank===r;}); if(!d) return;
        var av=avatarColor(d.hoTen);
        html+='<div class="rk-pod rk-pod-'+r+'">'+
            '<div class="rk-pod-avatar" style="background:'+av+'">'+initials(d.hoTen)+'</div>'+
            '<div class="rk-pod-icon">'+icons[r]+'</div>'+
            '<div class="rk-pod-name">'+(d.hoTen||'')+'</div>'+
            '<div class="rk-pod-unit">'+(d.phongBan||'')+'</div>'+
            '<div class="rk-pod-score">'+d.diemCaoNhat+'<span style="font-size:.7rem;color:#6b7280;font-weight:400"> điểm</span></div>'+
            '<div class="rk-pod-base rk-base-'+r+'">Hạng '+r+'</div>'+
            '</div>';
    });
    html+='</div>';
    $('#podiumWrap').html(html);
}

$(document).ready(function(){
    loadStats(); load();
    $('#btnLoad').on('click',function(){ loadStats(); load(); });
    $('#filterLopHoc').on('change',function(){ loadStats(); load(); });
    $('#filterPhongBan').on('change',load);
    var st;
    $('#txtSearch').on('input',function(){
        $('#btnClear').toggle(!!$(this).val());
        clearTimeout(st); st=setTimeout(load,300);
    });
    $('#btnClear').on('click',function(){ $('#txtSearch').val('').trigger('input'); });
});
</script>
