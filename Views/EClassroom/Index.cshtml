<script type="text/javascript">
    $('#btn-his').click(function () {
        window.location.href = "/SHistory/Index/";
    });
</script>

<script>
    $(document).ready(function () {
        const unfinishedIDLH = localStorage.getItem("IDLH");

        $('.exam-link').each(function () {
            const currentLHID = $(this).data('lhid');

            if (unfinishedIDLH && unfinishedIDLH !== currentLHID.toString()) {
                $(this).on('click', function (e) {
                    e.preventDefault();
                    alert('Bạn cần hoàn thành bài đang thi !');
                });
            }
            if (unfinishedIDLH && unfinishedIDLH === currentLHID.toString()) {
                $(this).find('span')
                    .removeClass('btn-outline-success')
                    .addClass('btn-warning')
                    .text('Đang thi');
            }
        });
    });
</script>
