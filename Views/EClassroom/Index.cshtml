                                                                                    <span class="btn-transition btn btn-outline-primary">Xem lịch sử ôn luyện</span>
                                                                                </a>
                                                                            }
                                                                        }
                                                                    }
                                                                    else
                                                                    {
                                                                        <span class="text-danger">Chưa đến giờ thi, đề thi sẽ mở vào lúc @item.TGBDLH.ToString("HH") giờ @item.TGBDLH.ToString("mm") ngày @item.TGBDLH.ToString("dd/MM/yyyy")</span>
                                                                    }
                                                                }
                                                            </div>
                                                        </div>
                                                    </div>
                                                </div>
                                            </div>
                                        }
                                    </div>
                                }

                                @* Chủ đề Điện *@
                                @if (chudeondien.Count != 0)
                                {
                                    <div class="card-title">Chủ đề Điện</div>
                                    <div class="row">
                                        @foreach (var item in chudeondien)
                                        {
                                            <div class="col-md-6 col-xl-3">
                                                <div class="card mb-3">
