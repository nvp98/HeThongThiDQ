                                                                    <div class="widget-content-left"><strong>Số lượt ôn luyện: </strong></div>
                                                                    <div class="widget-content-right text-danger">@item.BaiThiCount lượt</div>
                                                                </div>
                                                            }
                                                        }
                                                        <div class="widget-content-wrapper" style="padding: .5rem 0;">
