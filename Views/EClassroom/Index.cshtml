@{
    ViewBag.Title = "Khóa thi của bạn";
    Layout = "~/Views/Shared/_Layout.cshtml";
}

@using HeThongThiDQ.Models
@model List<EClassroomValidation>

@if (TempData["msgSuccess"] != null)
{
    @Html.Raw(TempData["msgSuccess"])
}
@if (TempData["msgError"] != null)
{
    @Html.Raw(TempData["msgError"])
}
@if (TempData["ClearLocalStorage"] != null)
{
    <script>localStorage.removeItem("IDNV"); localStorage.removeItem("IDLH");</script>
}

@{
    var chudeondien = Model.Where(x => x.ThiNhieuLan == 1 && x.TenLH != null && x.TenLH.Contains("Điện")).ToList();
    var chudeoncokhi = Model.Where(x => x.ThiNhieuLan == 1 && x.TenLH != null && x.TenLH.Contains("Cơ khí")).ToList();
    var chudeonantoan = Model.Where(x => x.ThiNhieuLan == 1 && x.TenLH != null && x.TenLH.Contains("ATMT")).ToList();
    var checkontap = Model.Where(x => x.ThiNhieuLan == 1).ToList();
    var checkthi = Model.Where(x => x.ThiNhieuLan != 1).ToList();
    // Đề thi chính thức chỉ mở khi đã nộp ít nhất 1 bài cho MỌI đề ôn luyện (kiểm tra lại ở STest/Index)
    var soDeDaOn = checkontap.Count(x => x.BaiThiCount > 0);
    var daOnXong = soDeDaOn == checkontap.Count;
    var soChuDe = (chudeonantoan.Count > 0 ? 1 : 0) + (chudeoncokhi.Count > 0 ? 1 : 0) + (chudeondien.Count > 0 ? 1 : 0);
}

<style>
    .ec-page {
        display: flex;
        align-items: stretch;
        height: calc(100vh - 60px);
        overflow: hidden;
        background: #fff;
        width: 100%;
        box-sizing: border-box;
    }

    /* ---- Cột danh sách bên trái ---- */
    .ec-side {
        width: 300px;
        flex-shrink: 0;
        background: #fff;
        border-right: 1px solid #e6eaf0;
        display: flex;
        flex-direction: column;
        min-width: 0;
    }

    .ec-brand {
        padding: 18px 20px 14px;
        text-align: center;
    }

    .ec-brand-name {
        font-size: 30px;
        font-weight: 900;
        font-style: italic;
        letter-spacing: 1px;
        line-height: 1;
        color: #1a3a8a;
        text-shadow: 1px 2px 0 #c9d6ee;
    }

    .ec-brand-sub {
        font-size: 11px;
        font-weight: 800;
        letter-spacing: 1.5px;
        text-transform: uppercase;
        color: #1a3a8a;
        margin-top: 4px;
    }

    .ec-scroll {
        flex: 1;
        overflow-y: auto;
        padding-bottom: 16px;
    }

    .ec-section+.ec-section {
        margin-top: 14px;
    }

    .ec-section-head {
        display: flex;
        align-items: center;
        justify-content: space-between;
        gap: 8px;
        background: #0d47a1;
        color: #fff;
        padding: 9px 16px;
        font-size: 14px;
        font-weight: 800;
        text-transform: uppercase;
        letter-spacing: .3px;
        cursor: pointer;
        user-select: none;
    }

    .ec-section-head.official {
        background: #c62828;
    }

    .ec-section-count {
        font-size: 11px;
        font-weight: 700;
        background: rgba(255, 255, 255, .2);
        border-radius: 10px;
        padding: 1px 8px;
        margin-left: 6px;
        text-transform: none;
    }

    .ec-caret {
        transition: transform .2s;
    }

    .ec-section.collapsed .ec-caret {
        transform: rotate(-90deg);
    }

    .ec-section.collapsed .ec-section-body {
        display: none;
    }

    /* Bộ lọc chủ đề */
    .ec-filter {
        display: flex;
        gap: 6px;
        flex-wrap: wrap;
        padding: 10px 16px 4px;
    }

    .ec-chip {
        font-size: 11.5px;
        font-weight: 700;
        padding: 3px 10px;
        border-radius: 14px;
        border: 1px solid #d5dbe5;
        color: #555;
        background: #fff;
        cursor: pointer;
        user-select: none;
    }

    .ec-chip.active {
        background: #0d47a1;
        border-color: #0d47a1;
        color: #fff;
    }

    .ec-dot {
        display: inline-block;
        width: 7px;
        height: 7px;
        border-radius: 50%;
        margin-right: 4px;
        vertical-align: middle;
    }

    /* Danh sách đề */
    .ec-list {
        list-style: none;
        margin: 0;
        padding: 0;
    }

    .ec-item {
        display: flex;
        align-items: center;
        gap: 8px;
        padding: 9px 16px 9px 22px;
        border-bottom: 1px solid #f1f3f6;
        border-left: 3px solid transparent;
        transition: background .12s;
    }

    .ec-item:hover {
        background: #f3f7ff;
        border-left-color: #1a73e8;
    }

    .ec-item.hide {
        display: none;
    }

    .ec-item-main {
        flex: 1;
        min-width: 0;
        text-decoration: none;
        color: inherit;
    }

    a.ec-item-main:hover {
        text-decoration: none;
        color: inherit;
    }

    .ec-item-name {
        font-size: 14.5px;
        color: #1a2744;
        line-height: 1.35;
        overflow: hidden;
        text-overflow: ellipsis;
        white-space: nowrap;
    }

    a.ec-item-main .ec-item-name {
        color: #0d47a1;
        font-weight: 600;
    }

    .ec-item-meta {
        font-size: 11.5px;
        color: #8a93a3;
        margin-top: 2px;
    }

    .ec-item-meta .st-open {
        color: #2e7d32;
        font-weight: 700;
    }

    .ec-item-meta .st-done {
        color: #1558b0;
        font-weight: 700;
    }

    .ec-item-meta .st-lock {
        color: #e65100;
        font-weight: 700;
    }

    .ec-item-meta .st-exp {
        color: #b71c1c;
        font-weight: 700;
    }

    .ec-item-meta.continuing .st-open {
        color: #1a73e8;
    }

    .ec-actions {
        display: flex;
        gap: 4px;
        flex-shrink: 0;
    }

    .ec-icon-btn {
        width: 28px;
        height: 28px;
        border-radius: 6px;
        display: inline-flex;
        align-items: center;
        justify-content: center;
        color: #1a73e8;
        background: #eef4ff;
        font-size: 13px;
        text-decoration: none;
    }

    .ec-icon-btn:hover {
        background: #1a73e8;
        color: #fff;
        text-decoration: none;
    }

    .ec-empty {
        padding: 14px 22px;
        font-size: 13px;
        color: #999;
    }

    /* ---- Banner bên phải ---- */
    .ec-banner {
        flex: 1;
        min-width: 0;
        display: flex;
        flex-direction: column;
        gap: 8px;
        padding: 8px;
        background: #fff;
    }

    /* Dải khẩu hiệu chào mừng 10 năm (giữ đúng tỉ lệ ảnh 2560 x 341) */
    .ec-banner-top {
        flex: none;
        aspect-ratio: 2560 / 341;
        background: #0d47a1 url('/Content/assets/images/chaomung_qday_khauhieu_web.jpg') center / 100% 100% no-repeat;
    }

    /* Banner Q-DAY lấp phần còn lại */
    .ec-banner-main {
        flex: 1;
        min-height: 0;
        background: #0d47a1 url('/Content/assets/images/Banner_login_qday_2.jpg') center / 100% 100% no-repeat;
    }

    @@media (max-width: 767px) {
        .ec-page {
            flex-direction: column;
            height: auto;
            overflow: visible;
        }

        .ec-banner {
            order: -1;
            flex: none;
        }

        .ec-banner-main {
            flex: none;
            aspect-ratio: 16 / 9;
        }

        .ec-side {
            width: 100%;
            border-right: none;
        }

        .ec-scroll {
            overflow: visible;
        }
    }

    /* ---- Hộp xác nhận bắt đầu bài thi ---- */
    .ec-confirm {
        position: fixed;
        inset: 0;
        z-index: 10050;
        background: rgba(10, 20, 40, .55);
        display: flex;
        align-items: center;
        justify-content: center;
        padding: 16px;
    }

    .ec-confirm[hidden] {
        display: none;
    }

    .ec-confirm-box {
        background: #fff;
        border-radius: 12px;
        width: 100%;
        max-width: 400px;
        box-shadow: 0 12px 40px rgba(0, 0, 0, .25);
        overflow: hidden;
        text-align: center;
    }

    .ec-confirm-body {
        padding: 24px 22px 18px;
    }

    .ec-confirm-icon {
        width: 56px;
        height: 56px;
        border-radius: 50%;
        background: #e8f0fe;
        color: #0d47a1;
        font-size: 26px;
        display: inline-flex;
        align-items: center;
        justify-content: center;
        margin-bottom: 12px;
    }

    .ec-confirm-title {
        font-size: 17px;
        font-weight: 800;
        color: #1a2744;
        margin-bottom: 6px;
    }

    .ec-confirm-name {
        font-size: 14px;
        color: #0d47a1;
        font-weight: 600;
        word-break: break-word;
    }

    .ec-confirm-foot {
        display: flex;
        gap: 10px;
        padding: 0 22px 20px;
    }

    .ec-confirm-foot button {
        flex: 1;
        border: none;
        border-radius: 8px;
        padding: 10px 12px;
        font-size: 14px;
        font-weight: 700;
        cursor: pointer;
    }

    .ec-confirm-cancel {
        background: #f1f3f6;
        color: #555;
    }

    .ec-confirm-ok {
        background: #0d47a1;
        color: #fff;
    }

    .ec-confirm-ok:hover {
        background: #1558b0;
    }
</style>

<div class="app-main__outer" style="overflow:hidden;min-width:0;">
    <div class="app-main__inner" style="padding:0;min-width:0;overflow:hidden;">
        <div class="ec-page">

            <aside class="ec-side">
                @* <div class="ec-brand">
                    <div class="ec-brand-name">Q.DAY</div>
                    <div class="ec-brand-sub">Tôi luyện chất thép</div>
                </div> *@

                <div class="ec-scroll">

                    @* ===== ĐỀ THI CHÍNH THỨC ===== *@
                    @if (checkthi.Count > 0)
                    {
                        <div class="ec-section">
                            <div class="ec-section-head official">
                                <span><i class="fa fa-flag-checkered" style="margin-right:6px;"></i>Đề thi chính thức</span>
                                <i class="fa fa-caret-down ec-caret"></i>
                            </div>
                            <div class="ec-section-body">
                                <ul class="ec-list">
                                    @foreach (var item in checkthi)
                                    {
                                        var isOpen = DateTime.Now >= item.TGBDLH && DateTime.Now <= item.TGKTLH;
                                        var isExpired = DateTime.Now > item.TGKTLH;
                                        var hasResult = item.BaiThiCount > 0;
                                        var resultUrl = Url.Action("TestView", "ConfirmEStudy", new
                                        {
                                            LHID = item.LHID,
                                            IDNV =
                                item.NVID,
                                            IDBaiThi = item.LastIDBaiThi
                                        });
                                        <li class="ec-item" title="@item.TenLH">
                                            @if (hasResult)
                                            {
                                                <a class="ec-item-main" href="@resultUrl">
                                                    <div class="ec-item-name">@item.TenLH</div>
                                                    <div class="ec-item-meta">
                                                        <span class="st-done">Đã thi</span> · Điểm @item.LastDiemSo/@item.TongDiem ·
                                                        Đúng @item.SoCauDung/@item.TongSoCau
                                                    </div>
                                                </a>
                                            }
                                            else if (isOpen && !daOnXong)
                                            {
                                                @* Rule: phải hoàn thành tất cả đề ôn luyện mới được mở đề thi chính thức.
                                                   data-lhid để JS vẫn cho "Tiếp tục" nếu đã lỡ bắt đầu bài này trước đó. *@
                                                <div class="ec-item-main ec-locked-official" data-lhid="@item.LHID">
                                                    <div class="ec-item-name">@item.TenLH</div>
                                                    <div class="ec-item-meta">
                                                        <span class="st-lock"><i class="fa fa-lock"></i> Hoàn thành tất cả đề ôn
                                                            luyện để mở</span>
                                                            · @soDeDaOn/@checkontap.Count đề
                                                        </div>
                                                    </div>
                                                }
                                            else if (isOpen)
                                                {
                                                    <a class="ec-item-main exam-link" data-lhid="@item.LHID"
                                                       href="/STest/Index?LHID=@item.LHID">
                                                        <div class="ec-item-name">@item.TenLH</div>
                                                        <div class="ec-item-meta">
                                                            <span class="st-open">Vào làm bài thi</span> · đến
                                                            @item.TGKTLH.ToString("HH:mm dd/MM")
                                                        </div>
                                                    </a>
                                                }
                                                else
                                                {
                                                    <div class="ec-item-main">
                                                        <div class="ec-item-name">@item.TenLH</div>
                                                        <div class="ec-item-meta">
                                                            @if (isExpired)
                                                            {
                                                                <span class="st-exp">Đã hết hạn</span>
                                                            }
                                                            else
                                                            {
                                                                <span class="st-lock"><i class="fa fa-lock"></i> Mở lúc
                                                                    @item.TGBDLH.ToString("HH:mm dd/MM")</span>
                                                                }
                                                            </div>
                                                        </div>
                                                    }
                                                    @if (hasResult)
                                                    {
                                                        <div class="ec-actions">
                                                            <a class="ec-icon-btn" href="@resultUrl" title="Xem kết quả"><i
                                                                class="fa fa-bar-chart"></i></a>
                                                            </div>
                                                        }
                                                    </li>
                                                }
                                            </ul>
                                        </div>
                                    </div>
                                }

                                @* ===== ÔN LUYỆN ===== *@
                                <div class="ec-section on-luyen">
                                    <div class="ec-section-head">
                                        <span><i class="fa fa-book" style="margin-right:6px;"></i>Đề ôn luyện<span
                                            class="ec-section-count">@checkontap.Count</span></span>
                                            <i class="fa fa-caret-down ec-caret"></i>
                                        </div>
                                        <div class="ec-section-body">
                                            @if (soChuDe > 1)
                                            {
                                                <div class="ec-filter">
                                                    <span class="ec-chip active" data-filter="all">Tất cả</span>
                                                    @if (chudeonantoan.Count > 0)
                                                    {
                                                        <span class="ec-chip" data-filter="atmt"><span class="ec-dot"
                                                                                                           style="background:#43a047;"></span>An toàn</span>
                                                        }
                                                        @if (chudeoncokhi.Count > 0)
                                                        {
                                                            <span class="ec-chip" data-filter="cokhi"><span class="ec-dot"
                                                                                                                style="background:#f57c00;"></span>Cơ khí</span>
                                                            }
                                                            @if (chudeondien.Count > 0)
                                                            {
                                                                <span class="ec-chip" data-filter="dien"><span class="ec-dot"
                                                                                                                   style="background:#1a73e8;"></span>Điện</span>
                                                                }
                                                            </div>
                                                        }

                                                        @if (checkontap.Count == 0)
                                                        {
                                                            <div class="ec-empty">Chưa có đề ôn luyện.</div>
                                                        }
                                                        <ul class="ec-list">
                                                            @foreach (var item in checkontap)
                                                            {
                                                                var isOpen = DateTime.Now >= item.TGBDLH && DateTime.Now <= item.TGKTLH;
                                                                var isExpired = DateTime.Now > item.TGKTLH;
                                                                var hasResult = item.BaiThiCount > 0;

                                                                string cat = "all";
                                                                if (item.TenLH != null && item.TenLH.Contains("ATMT")) { cat = "atmt"; }
                                                                else if (item.TenLH != null && item.TenLH.Contains("Cơ khí")) { cat = "cokhi"; }
                                                                else if (item.TenLH != null && item.TenLH.Contains("Điện")) { cat = "dien"; }

                                                                <li class="ec-item" data-cat="@cat" title="@item.TenLH">
                                                                    @if (isOpen)
                                                                    {
                                                                        <a class="ec-item-main exam-link" data-lhid="@item.LHID"
                                                                           href="/STest/Index?LHID=@item.LHID">
                                                                            <div class="ec-item-name">@item.TenLH</div>
                                                                            <div class="ec-item-meta">
                                                                                @if (hasResult)
                                                                                {
                                                                                    <span class="st-open">Ôn lại</span> <text>· @item.BaiThiCount lượt · Điểm
                                                                                    @item.LastDiemSo/@item.TongDiem</text>
                                                                                }
                                                                                else
                                                                                {
                                                                                    <span class="st-open">Bắt đầu ôn luyện</span>
                                                                                }
                                                                            </div>
                                                                        </a>
                                                                    }
                                                                    else
                                                                    {
                                                                        <div class="ec-item-main">
                                                                            <div class="ec-item-name">@item.TenLH</div>
                                                                            <div class="ec-item-meta">
                                                                                @if (!isExpired)
                                                                                {
                                                                                    <span class="st-lock"><i class="fa fa-lock"></i> Mở lúc
                                                                                        @item.TGBDLH.ToString("HH:mm dd/MM")</span>
                                                                                    }
                                                    else if (hasResult)
                                                                                    {
                                                                                        <span class="st-done">Đã kết thúc</span> <text>· @item.BaiThiCount lượt ·
                                                                                        Điểm @item.LastDiemSo/@item.TongDiem</text>
                                                                                    }
                                                                                    else
                                                                                    {
                                                                                        <span class="st-exp">Hết hạn</span>
                                                                                    }
                                                                                </div>
                                                                            </div>
                                                                        }
                                                                        @if (hasResult && (isOpen || isExpired))
                                                                        {
                                                                            <div class="ec-actions">
                                                                                <a class="ec-icon-btn" title="Xem kết quả"
                                                                                   href="@Url.Action("TestView","ConfirmEStudy",new{LHID=item.LHID,IDNV=item.NVID,IDBaiThi=item.LastIDBaiThi})">
                                                                                    <i class="fa fa-bar-chart"></i>
                                                                                </a>
                                                                                <a class="ec-icon-btn" title="Lịch sử ôn luyện"
                                                                                   href="@Url.Action("PracticeHistory","EClassroom",new{IDLH=item.LHID})">
                                                                                    <i class="fa fa-history"></i>
                                                                                </a>
                                                                            </div>
                                                                        }
                                                                    </li>
                                                                }
                                                            </ul>
                                                        </div>
                                                    </div>

                                                </div>
                                            </aside>

                                            <div class="ec-banner">
                                                <div class="ec-banner-top" role="img"
                                                     aria-label="Chào mừng 10 năm thành lập Công ty Cổ phần Thép Hòa Phát Dung Quất"></div>
                                                <div class="ec-banner-main" role="img"
                                                     aria-label="Q-DAY - Hiểu văn hóa, thấu giá trị"></div>
                                            </div>
                                        </div>
                                    </div>
                                </div>

                                <div class="ec-confirm" id="ecConfirm" hidden>
                                    <div class="ec-confirm-box" role="dialog" aria-modal="true" aria-labelledby="ecConfirmTitle">
                                        <div class="ec-confirm-body">
                                            <div class="ec-confirm-icon"><i class="fa fa-pencil-square-o"></i></div>
                                            <div class="ec-confirm-title" id="ecConfirmTitle">Bạn muốn bắt đầu bài thi?</div>
                                            <div class="ec-confirm-name" id="ecConfirmName"></div>
                                        </div>
                                        <div class="ec-confirm-foot">
                                            <button type="button" class="ec-confirm-cancel" id="ecConfirmCancel">Hủy</button>
                                            <button type="button" class="ec-confirm-ok" id="ecConfirmOk">Bắt đầu</button>
                                        </div>
                                    </div>
                                </div>

                                <script>
                                    $(document).ready(function () {

                                        // Hộp xác nhận trước khi vào màn hình thi
                                        var confirmEl = document.getElementById('ecConfirm');
                                        var pendingUrl = null;

                                        function openConfirm(url, name) {
                                            pendingUrl = url;
                                            $('#ecConfirmName').text(name || '');
                                            confirmEl.hidden = false;
                                            $('#ecConfirmOk').trigger('focus');
                                        }

                                        function closeConfirm() {
                                            confirmEl.hidden = true;
                                            pendingUrl = null;
                                        }

                                        $('#ecConfirmOk').on('click', function () {
                                            if (pendingUrl) {
                                                $(this).prop('disabled', true).html('<i class="fa fa-spinner fa-spin"></i> Đang vào...');
                                                window.location.href = pendingUrl;
                                            }
                                        });
                                        $('#ecConfirmCancel').on('click', closeConfirm);
                                        $(confirmEl).on('click', function (e) {
                                            if (e.target === confirmEl) closeConfirm();
                                        });
                                        $(document).on('keydown', function (e) {
                                            if (e.key === 'Escape' && !confirmEl.hidden) closeConfirm();
                                        });

                                        // Thu gọn / mở rộng từng nhóm
                                        $('.ec-section-head').on('click', function () {
                                            $(this).closest('.ec-section').toggleClass('collapsed');
                                        });

                                        // Lọc theo chủ đề
                                        $('.ec-chip').on('click', function () {
                                            $('.ec-chip').removeClass('active');
                                            $(this).addClass('active');
                                            var filter = $(this).data('filter');
                                            $(this).closest('.ec-section-body').find('.ec-item').each(function () {
                                                $(this).toggleClass('hide', !(filter === 'all' || $(this).data('cat') === filter));
                                            });
                                        });

                                        // Kiểm tra bài thi đang làm dở
                                        const unfinishedIDLH = localStorage.getItem("IDLH");

                                        // Đề chính thức bị khoá nhưng đang làm dở → cho vào tiếp (server cũng cho phép khôi phục phiên)
                                        $('.ec-locked-official').each(function () {
                                            const lhid = $(this).data('lhid');
                                            if (unfinishedIDLH && unfinishedIDLH === lhid.toString()) {
                                                $(this).replaceWith(
                                                    $('<a class="ec-item-main exam-link">')
                                                        .attr({ 'data-lhid': lhid, href: '/STest/Index?LHID=' + lhid })
                                                        .append($(this).find('.ec-item-name').clone())
                                                        .append('<div class="ec-item-meta"></div>')
                                                );
                                            }
                                        });
                                        $('.exam-link').each(function () {
                                            const currentLHID = $(this).data('lhid');
                                            if (unfinishedIDLH && unfinishedIDLH !== currentLHID.toString()) {
                                                $(this).on('click', function (e) {
                                                    e.preventDefault();
                                                    alert('Bạn cần hoàn thành bài đang thi !');
                                                });
                                            }
                                            else if (unfinishedIDLH && unfinishedIDLH === currentLHID.toString()) {
                                                // Bài đang làm dở: vào tiếp luôn, không cần hỏi lại
                                                $(this).find('.ec-item-meta').addClass('continuing')
                                                    .html('<span class="st-open"><i class="fa fa-spinner fa-spin"></i> Đang thi — Tiếp tục</span>');
                                            }
                                            else {
                                                $(this).on('click', function (e) {
                                                    e.preventDefault();
                                                    openConfirm($(this).attr('href'), $.trim($(this).find('.ec-item-name').text()));
                                                });
                                            }
                                        });
                                    });
                                </script>
