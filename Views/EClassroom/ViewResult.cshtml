@{
    ViewBag.Title = "Kết quả thi";
    Layout = "~/Views/Shared/_Layout.cshtml";

    var raw = (string)(ViewBag.DiemThi ?? "0/100");

    int tgGiay = (int)(ViewBag.ThoiGianThiGiay ?? 0);
    var tgSpan = TimeSpan.FromSeconds(tgGiay);
    string tgDisplay;
    if (tgGiay <= 0) tgDisplay = "--";
    else if ((int)tgSpan.TotalHours > 0) tgDisplay = $"{(int)tgSpan.TotalHours} giờ {tgSpan.Minutes} phút {tgSpan.Seconds} giây";
    else tgDisplay = $"{tgSpan.Minutes} phút {tgSpan.Seconds} giây";

    DateTime? gioBatDau = ViewBag.GioBatDau as DateTime?;
    DateTime? gioKetThuc = ViewBag.GioKetThuc as DateTime?;
    string batDauStr = gioBatDau.HasValue ? gioBatDau.Value.ToString("HH:mm:ss dd-MM-yyyy") : "--:--:--";
    string ketThucStr = gioKetThuc.HasValue ? gioKetThuc.Value.ToString("HH:mm:ss dd-MM-yyyy") : "--:--:--";

    string taiKhoan = (string)(ViewBag.TaiKhoan ?? "--");
    string hoTen    = (string)(ViewBag.HoTen ?? "--");

    int tongSoCauHoi    = (int)(ViewBag.TongSoCauHoi ?? 0);
    int soCauDung       = (int)(ViewBag.SoCauDung ?? 0);
    int soCauSai        = (int)(ViewBag.SoCauSai ?? 0);
    int soCauChuaTraLoi = (int)(ViewBag.SoCauChuaTraLoi ?? 0);
}

<style>
    .kq-outer {
        min-height: calc(100vh - 60px);
        background-color: #4f9ee8;
        background-image: url('/Content/assets/images/bg_ketqua.jpg');
        background-size: cover;
        background-position: center bottom;
        background-repeat: no-repeat;
        display: flex;
        flex-direction: column;
        align-items: center;
        justify-content: center;
        padding: 40px 16px;
    }

    .kq-header {
        text-align: center;
        margin-bottom: 22px;
    }

    .kq-logo {
        font-size: 44px;
        font-weight: 900;
        color: #123e91;
        letter-spacing: 2px;
        line-height: 1;
        text-shadow: 0 2px 10px rgba(255,255,255,.55);
    }

    .kq-sub1 {
        margin-top: 8px;
        font-size: 15px;
        font-weight: 700;
        color: #123e91;
        letter-spacing: .5px;
    }

    .kq-slogan {
        margin-top: 6px;
        font-size: 24px;
        font-weight: 900;
        letter-spacing: .3px;
    }

    .kq-slogan .blue { color: #123e91; }
    .kq-slogan .red  { color: #e53935; }

    .kq-title-row {
        margin-top: 18px;
        display: flex;
        align-items: center;
        justify-content: center;
        gap: 18px;
    }

    .kq-title-line {
        flex: 1 1 0;
        max-width: 130px;
        height: 3px;
        border-radius: 3px;
        position: relative;
    }

    .kq-title-line.blue { background: linear-gradient(90deg, transparent, #1a56b0); }
    .kq-title-line.blue::after {
        content: '';
        position: absolute;
        right: -4px; top: -3px;
        width: 9px; height: 9px;
        border-radius: 50%;
        background: #1a56b0;
    }

    .kq-title-line.red { background: linear-gradient(90deg, #e53935, transparent); }
    .kq-title-line.red::after {
        content: '';
        position: absolute;
        left: -4px; top: -3px;
        width: 9px; height: 9px;
        border-radius: 50%;
        background: #e53935;
    }

    .kq-title {
        font-size: 40px;
        font-weight: 900;
        color: #123e91;
    }

    .kq-panels {
        width: 100%;
        max-width: 760px;
        display: flex;
        flex-direction: column;
        gap: 18px;
    }

    .kq-panel {
        background: rgba(255,255,255,.94);
        backdrop-filter: blur(6px);
        border-radius: 22px;
        box-shadow: 0 10px 40px rgba(10,40,90,.18);
        padding: 8px 32px;
        display: grid;
        grid-template-columns: 1fr 1fr;
    }

    .kq-col {
        display: flex;
        flex-direction: column;
    }

    .kq-col + .kq-col {
        border-left: 1px solid rgba(10,40,90,.10);
        padding-left: 32px;
        margin-left: 32px;
    }

    .kq-row {
        display: flex;
        align-items: center;
        gap: 14px;
        padding: 16px 0;
    }

    .kq-row + .kq-row {
        border-top: 1px solid rgba(10,40,90,.08);
    }

    .kq-icon {
        flex-shrink: 0;
        width: 38px;
        height: 38px;
        border-radius: 50%;
        display: flex;
        align-items: center;
        justify-content: center;
    }

    .kq-icon.c-blue { background: #1a56b0; }
    .kq-icon.c-red  { background: #e53935; }
    .kq-icon.c-gray { background: #9aa0a6; }

    .kq-label {
        font-size: 13px;
        color: #5c6b85;
        font-weight: 500;
    }

    .kq-value {
        margin-top: 2px;
        font-size: 19px;
        font-weight: 800;
        color: #123e91;
        word-break: break-word;
    }

    .kq-value.c-red  { color: #e53935; }
    .kq-value.c-gray { color: #757b85; }

    .kq-actions {
        margin-top: 6px;
        display: flex;
        flex-direction: column;
        gap: 10px;
        width: 100%;
        max-width: 380px;
    }

    .btn-kq-primary {
        background: linear-gradient(135deg, #1a56b0, #123e91);
        color: #fff;
        border: none;
        border-radius: 12px;
        padding: 13px 20px;
        font-size: 15px;
        font-weight: 700;
        text-align: center;
        text-decoration: none;
        display: block;
        box-shadow: 0 4px 16px rgba(18,62,145,.35);
        transition: opacity .2s, transform .15s;
    }

    .btn-kq-primary:hover { opacity: .92; transform: translateY(-1px); color: #fff; }

    .btn-kq-secondary {
        background: rgba(255,255,255,.9);
        color: #123e91;
        border: none;
        border-radius: 12px;
        padding: 12px 20px;
        font-size: 14px;
        font-weight: 700;
        text-align: center;
        text-decoration: none;
        display: block;
        transition: background .15s;
    }

    .btn-kq-secondary:hover { background: #fff; color: #0d2c6b; }

    @@media (max-width:640px) {
        .kq-logo { font-size: 32px; }
        .kq-slogan { font-size: 17px; }
        .kq-title { font-size: 28px; }
        .kq-title-line { max-width: 50px; }
        .kq-panel { grid-template-columns: 1fr; padding: 4px 20px; }
        .kq-col + .kq-col { border-left: none; border-top: 1px solid rgba(10,40,90,.10); padding-left: 0; margin-left: 0; padding-top: 8px; margin-top: 8px; }
        .kq-value { font-size: 17px; }
    }
</style>

<div class="app-main__outer">
    <div class="app-main__inner" style="padding:0;">
        <div class="kq-outer">

            <div class="kq-header">
                <div class="kq-logo">Q.DAY</div>
                <div class="kq-sub1">HỌC TẬP - TÌM HIỂU Q.DAY HÒA PHÁT DUNG QUẤT</div>
                <div class="kq-slogan"><span class="blue">HIỂU CHẤT THÉP -</span> <span class="red">THẤM CHẤT NHÀ</span></div>
                <div class="kq-title-row">
                    <span class="kq-title-line blue"></span>
                    <span class="kq-title">KẾT QUẢ</span>
                    <span class="kq-title-line red"></span>
                </div>
            </div>

            <div class="kq-panels">

                <div class="kq-panel">
                    <div class="kq-col">
                        <div class="kq-row">
                            <div class="kq-icon c-blue">
                                <svg width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="#fff" stroke-width="2.2"><circle cx="12" cy="8" r="4" /><path d="M4 21c0-4.4 3.6-8 8-8s8 3.6 8 8" /></svg>
                            </div>
                            <div>
                                <div class="kq-label">Tài khoản:</div>
                                <div class="kq-value">@taiKhoan</div>
                            </div>
                        </div>
                        <div class="kq-row">
                            <div class="kq-icon c-blue">
                                <svg width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="#fff" stroke-width="2.2"><circle cx="12" cy="8" r="4" /><path d="M4 21c0-4.4 3.6-8 8-8s8 3.6 8 8" /></svg>
                            </div>
                            <div>
                                <div class="kq-label">Họ tên:</div>
                                <div class="kq-value">@hoTen</div>
                            </div>
                        </div>
                    </div>
                    <div class="kq-col">
                        <div class="kq-row">
                            <div class="kq-icon c-blue">
                                <svg width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="#fff" stroke-width="2.2"><circle cx="12" cy="12" r="9" /><path d="M12 7v5l3 3" /></svg>
                            </div>
                            <div>
                                <div class="kq-label">Thời gian bắt đầu:</div>
                                <div class="kq-value">@batDauStr</div>
                            </div>
                        </div>
                        <div class="kq-row">
                            <div class="kq-icon c-blue">
                                <svg width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="#fff" stroke-width="2.2"><path d="M5 3v18" /><path d="M5 4h11l-2 3.5L16 11H5" /></svg>
                            </div>
                            <div>
                                <div class="kq-label">Thời gian kết thúc:</div>
                                <div class="kq-value">@ketThucStr</div>
                            </div>
                        </div>
                    </div>
                </div>

                <div class="kq-panel">
                    <div class="kq-col">
                        <div class="kq-row">
                            <div class="kq-icon c-blue">
                                <svg width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="#fff" stroke-width="2.4"><path d="M5 13l4 4 10-10" /></svg>
                            </div>
                            <div>
                                <div class="kq-label">Số câu trả lời đúng:</div>
                                <div class="kq-value">@soCauDung</div>
                            </div>
                        </div>
                        <div class="kq-row">
                            <div class="kq-icon c-red">
                                <svg width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="#fff" stroke-width="2.4"><path d="M6 6l12 12M18 6L6 18" /></svg>
                            </div>
                            <div>
                                <div class="kq-label">Số câu trả lời sai:</div>
                                <div class="kq-value c-red">@soCauSai</div>
                            </div>
                        </div>
                        <div class="kq-row">
                            <div class="kq-icon c-gray">
                                <svg width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="#fff" stroke-width="2.4"><path d="M6 12h12" /></svg>
                            </div>
                            <div>
                                <div class="kq-label">Số câu chưa trả lời:</div>
                                <div class="kq-value c-gray">@soCauChuaTraLoi</div>
                            </div>
                        </div>
                    </div>
                    <div class="kq-col">
                        <div class="kq-row">
                            <div class="kq-icon c-blue">
                                <svg width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="#fff" stroke-width="2.2"><rect x="5" y="3" width="14" height="18" rx="2" /><line x1="8" y1="8" x2="16" y2="8" /><line x1="8" y1="12" x2="16" y2="12" /><line x1="8" y1="16" x2="13" y2="16" /></svg>
                            </div>
                            <div>
                                <div class="kq-label">Tổng số câu hỏi:</div>
                                <div class="kq-value">@tongSoCauHoi</div>
                            </div>
                        </div>
                        <div class="kq-row">
                            <div class="kq-icon c-blue">
                                <svg width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="#fff" stroke-width="2.2"><circle cx="12" cy="13" r="8" /><path d="M12 9v4l3 2" /><path d="M10 2h4" /></svg>
                            </div>
                            <div>
                                <div class="kq-label">Thời gian làm bài:</div>
                                <div class="kq-value">@tgDisplay</div>
                            </div>
                        </div>
                    </div>
                </div>

                <div class="kq-actions" style="align-self:center;">
                    <a class="btn-kq-primary"
                       href="@Url.Action("TestView", "ConfirmEStudy", new { LHID = ViewBag.IDLH, IDNV = ViewBag.IDNV, IDBaiThi = ViewBag.IDBaiThi })">
                        Xem chi tiết kết quả
                    </a>
                    <a class="btn-kq-secondary" href="@Url.Action("Index", "EClassroom")">
                        Quay về trang chính
                    </a>
                </div>

            </div>

        </div>
    </div>
</div>
