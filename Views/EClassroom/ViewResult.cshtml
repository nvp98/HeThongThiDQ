@{
    ViewBag.Title = "Kết quả thi";
    Layout = "~/Views/Shared/_Layout.cshtml";
}

<div class="container mt-5">
    <div id="resultModal" tabindex="-1" aria-labelledby="resultModalLabel" aria-hidden="true">
        <div class="modal-dialog">
            <div class="modal-content">
                <div class="modal-header">
                    <h5 class="modal-title font-weight-bold" id="resultModalLabel">Ban Tổ chức Hội thi Tay nghề giỏi Tập đoàn 2025 chúc mừng Anh/Chị đã hoàn thành Phần thi Lý thuyết</h5>
                </div>
                <div class="modal-body">
                    <span class="font-weight-bold text-danger font-size-lg" id="resultMessage">Với số điểm là: @ViewBag.DiemThi</span>
                </div>
                <div class="modal-footer">
                    <a href="@Url.Action("TestView", "ConfirmEStudy", new { LHID = ViewBag.IDLH, IDNV = ViewBag.IDNV, IDBaiThi = ViewBag.IDBaiThi })">
                        <span class="btn-transition btn btn-outline-primary">Xem kết quả ôn luyện</span>
                    </a>
                    <a href="@Url.Action("Index", "EClassroom")" class="btn btn-secondary">Quay về màn hình chính</a>
                </div>
            </div>
        </div>
    </div>
</div>

<script src="https://cdn.jsdelivr.net/npm/bootstrap@5.3.0/dist/js/bootstrap.bundle.min.js"></script>
