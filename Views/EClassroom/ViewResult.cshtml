@{
    ViewBag.Title = "Kết quả thi";
    Layout = "~/Views/Shared/_Layout.cshtml";

    var raw   = (string)(ViewBag.DiemThi ?? "0/100");
    var parts = raw.Split('/');
    double.TryParse(parts[0], System.Globalization.NumberStyles.Any,
                    System.Globalization.CultureInfo.InvariantCulture, out double scoreVal);
    double.TryParse(parts.Length > 1 ? parts[1] : "100",
                    System.Globalization.NumberStyles.Any,
                    System.Globalization.CultureInfo.InvariantCulture, out double totalVal);
    if (totalVal == 0) totalVal = 100;
    double pct = Math.Round(scoreVal / totalVal * 100, 1);

    string verdict, verdictColor, ringColor;
    if (pct >= 80)      { verdict = "Xuất sắc";    verdictColor = "#1b5e20"; ringColor = "#43a047"; }
    else if (pct >= 70) { verdict = "Đạt yêu cầu"; verdictColor = "#1565c0"; ringColor = "#1a73e8"; }
    else if (pct >= 50) { verdict = "Trung bình";  verdictColor = "#e65100"; ringColor = "#f57c00"; }
    else                { verdict = "Chưa đạt";    verdictColor = "#b71c1c"; ringColor = "#d32f2f"; }

    int tgGiay = (int)(ViewBag.ThoiGianThiGiay ?? 0);
    var tgSpan  = TimeSpan.FromSeconds(tgGiay);
    string tgDisplay = tgGiay > 0
        ? (tgGiay >= 3600
            ? $"{(int)tgSpan.TotalHours:D2}:{tgSpan.Minutes:D2}:{tgSpan.Seconds:D2}"
            : $"{tgSpan.Minutes:D2}:{tgSpan.Seconds:D2}")
        : "--:--";

    DateTime? gioBatDau  = ViewBag.GioBatDau  as DateTime?;
    DateTime? gioKetThuc = ViewBag.GioKetThuc as DateTime?;
    string batDauStr  = gioBatDau.HasValue  ? gioBatDau.Value.ToString("HH:mm:ss")  : "--:--:--";
    string ketThucStr = gioKetThuc.HasValue ? gioKetThuc.Value.ToString("HH:mm:ss") : "--:--:--";

    const double R = 70;
    double circ  = 2 * Math.PI * R;
    double offset = circ * (1 - pct / 100.0);
}

<style>
:root { --ring: @ringColor; --verdict: @verdictColor; }

.result-outer {
    min-height: calc(100vh - 60px);
    /* === ĐỔI ẢNH NỀN TẠI ĐÂY === */
    background-image: url('/Content/assets/images/bg4.jpg');
    background-size: cover;
    background-position: center;
    background-repeat: no-repeat;
    background-attachment: fixed;
    display: flex;
    align-items: center;
    justify-content: center;
    padding: 24px 16px;
    position: relative;
}
.result-outer::before {
    content: '';
    position: absolute;
    inset: 0;
    background: rgba(0, 0, 0, 0.40);
    pointer-events: none;
}

.result-card {
    background: #fff;
    border-radius: 24px;
    box-shadow: 0 8px 48px rgba(0, 0, 0, 0.30);
    position: relative;
    z-index: 1;
    overflow: hidden;
    max-width: 500px;
    width: 100%;
    padding: 40px 36px 36px;
    display: flex;
    flex-direction: column;
    align-items: center;
    gap: 20px;
    animation: slideUp .45s cubic-bezier(.22,.61,.36,1) both;
}
@@keyframes slideUp {
    from { opacity:0; transform:translateY(28px); }
    to   { opacity:1; transform:translateY(0); }
}


/* ---- Ring ---- */
.ring-wrap {
    position: relative;
    width: 168px; height: 168px;
    flex-shrink: 0;
}
.ring-wrap svg { display: block; }
.ring-track  { stroke: #e8eaf6; }
.ring-fill   {
    stroke: var(--ring);
    stroke-dasharray: @circ.ToString("F2", System.Globalization.CultureInfo.InvariantCulture);
    stroke-dashoffset: @circ.ToString("F2", System.Globalization.CultureInfo.InvariantCulture);
    stroke-linecap: round;
    transform: rotate(-90deg);
    transform-origin: 84px 84px;
    transition: stroke-dashoffset 1.2s cubic-bezier(.4,0,.2,1);
}
.ring-center {
    position: absolute;
    inset: 0;
    display: flex; flex-direction: column;
    align-items: center; justify-content: center;
    gap: 1px;
}
.ring-score  { font-size: 32px; font-weight: 800; color: var(--ring); line-height: 1; }
.ring-total  { font-size: 13px; color: #888; }

/* ---- Verdict ---- */
.verdict-badge {
    font-size: 15px; font-weight: 700;
    color: var(--verdict);
    background: color-mix(in srgb, var(--ring) 12%, white);
    padding: 6px 22px;
    border-radius: 30px;
    letter-spacing: .3px;
}

/* ---- Title ---- */
.result-title {
    font-size: 17px; font-weight: 700; color: #222;
    text-align: center; line-height: 1.45;
}
.result-subtitle { font-size: 13px; color: #777; text-align: center; }

/* ---- Info chips ---- */
.info-chips {
    display: flex; flex-wrap: wrap; gap: 10px;
    justify-content: center; width: 100%;
}
.chip {
    display: flex; align-items: center; gap: 7px;
    background: #f8f9fa;
    border-radius: 10px;
    padding: 9px 14px;
    font-size: 13px; color: #444;
}
.chip svg { flex-shrink: 0; color: #1a73e8; }
.chip strong { color: #222; }

/* ---- Buttons ---- */
.result-actions {
    display: flex; flex-direction: column; gap: 10px; width: 100%;
}
.btn-primary-main {
    background: linear-gradient(135deg, #1a73e8, #1558b0);
    color: #fff; border: none; border-radius: 12px;
    padding: 14px 20px; font-size: 15px; font-weight: 700;
    text-align: center; text-decoration: none; display: block;
    transition: opacity .2s, transform .15s;
    box-shadow: 0 4px 14px rgba(26,115,232,.35);
}
.btn-primary-main:hover { opacity:.9; transform:translateY(-1px); color:#fff; }

.btn-secondary-main {
    background: #f5f5f5; color: #555; border: none;
    border-radius: 12px; padding: 13px 20px;
    font-size: 14px; font-weight: 600;
    text-align: center; text-decoration: none; display: block;
    transition: background .15s;
}
.btn-secondary-main:hover { background:#ececec; color:#333; }

@@media (max-width:480px) {
    .result-card { padding: 28px 18px 24px; }
    .ring-wrap   { width:140px; height:140px; }
    .ring-score  { font-size:26px; }
}
</style>

<div class="app-main__outer">
    <div class="app-main__inner" style="padding:0;">
        <div class="result-outer">
            <div class="result-card">

                <!-- Score ring -->
                <div class="ring-wrap">
                    <svg width="168" height="168" viewBox="0 0 168 168">
                        <circle class="ring-track" cx="84" cy="84" r="@R.ToString("F0")"
                                fill="none" stroke-width="13"/>
                        <circle class="ring-fill" id="ringFill" cx="84" cy="84" r="@R.ToString("F0")"
                                fill="none" stroke-width="13"/>
                    </svg>
                    <div class="ring-center">
                        <span class="ring-score" id="scoreNum">0</span>
                        <span class="ring-total">/ @(totalVal % 1 == 0 ? ((int)totalVal).ToString() : totalVal.ToString("F1"))</span>
                    </div>
                </div>

                <!-- Verdict -->
                <div class="verdict-badge">@verdict</div>

                <!-- Title -->
                <div>
                    <div class="result-title">
                        Ban Tổ chức Hội thi Tay nghề giỏi<br>Tập đoàn 2025
                    </div>
                    <div class="result-subtitle" style="margin-top:6px;">
                        Chúc mừng Anh/Chị đã hoàn thành Phần thi Lý thuyết
                    </div>
                </div>

                <!-- Info -->
                <div class="info-chips">
                    <div class="chip">
                        <svg width="15" height="15" fill="none" stroke="currentColor" stroke-width="2"
                             viewBox="0 0 24 24"><path d="M9 12l2 2 4-4"/><circle cx="12" cy="12" r="10"/></svg>
                        Điểm số:&nbsp;<strong>@raw</strong>
                    </div>
                    <div class="chip">
                        <svg width="15" height="15" fill="none" stroke="currentColor" stroke-width="2"
                             viewBox="0 0 24 24"><rect x="3" y="4" width="18" height="18" rx="2"/><line x1="16" y1="2" x2="16" y2="6"/><line x1="8" y1="2" x2="8" y2="6"/><line x1="3" y1="10" x2="21" y2="10"/></svg>
                        Ngày:&nbsp;<strong>@DateTime.Now.ToString("dd/MM/yyyy")</strong>
                    </div>
                    <div class="chip">
                        <svg width="15" height="15" fill="none" stroke="currentColor" stroke-width="2"
                             viewBox="0 0 24 24"><polyline points="22 12 18 12 15 21 9 3 6 12 2 12"/></svg>
                        Tỉ lệ:&nbsp;<strong>@pct.ToString("F0")%</strong>
                    </div>
                    <div class="chip">
                        <svg width="15" height="15" fill="none" stroke="currentColor" stroke-width="2"
                             viewBox="0 0 24 24"><circle cx="12" cy="12" r="10"/><polyline points="12 6 12 12 16 14"/></svg>
                        Thời gian:&nbsp;<strong>@tgDisplay</strong>
                    </div>
                    <div class="chip">
                        <svg width="15" height="15" fill="none" stroke="currentColor" stroke-width="2"
                             viewBox="0 0 24 24"><circle cx="12" cy="12" r="10"/><line x1="12" y1="8" x2="12" y2="12"/><line x1="12" y1="16" x2="12.01" y2="16"/></svg>
                        Bắt đầu:&nbsp;<strong>@batDauStr</strong>
                    </div>
                    <div class="chip">
                        <svg width="15" height="15" fill="none" stroke="currentColor" stroke-width="2"
                             viewBox="0 0 24 24"><path d="M22 11.08V12a10 10 0 1 1-5.93-9.14"/><polyline points="22 4 12 14.01 9 11.01"/></svg>
                        Kết thúc:&nbsp;<strong>@ketThucStr</strong>
                    </div>
                </div>

                <!-- Actions -->
                <div class="result-actions">
                    <a class="btn-primary-main"
                       href="@Url.Action("TestView", "ConfirmEStudy", new { LHID = ViewBag.IDLH, IDNV = ViewBag.IDNV, IDBaiThi = ViewBag.IDBaiThi })">
                        Xem chi tiết kết quả
                    </a>
                    <a class="btn-secondary-main"
                       href="@Url.Action("Index", "EClassroom")">
                        Quay về trang chính
                    </a>
                </div>

            </div>
        </div>
    </div>
</div>

<script>
(function () {
    const score  = @scoreVal.ToString("F4", System.Globalization.CultureInfo.InvariantCulture);
    const total  = @totalVal.ToString("F4", System.Globalization.CultureInfo.InvariantCulture);
    const circ   = @circ.ToString("F4", System.Globalization.CultureInfo.InvariantCulture);
    const target = @offset.ToString("F4", System.Globalization.CultureInfo.InvariantCulture);
    const ring   = document.getElementById('ringFill');
    const numEl  = document.getElementById('scoreNum');
    const isInt  = score % 1 === 0;

    // Animate ring
    setTimeout(function () { ring.style.strokeDashoffset = target; }, 120);

    // Count-up number
    const dur = 1100, fps = 60, steps = Math.round(dur / (1000 / fps));
    let step = 0;
    const iv = setInterval(function () {
        step++;
        const t = step / steps;
        const ease = 1 - Math.pow(1 - t, 3);
        const cur  = score * ease;
        numEl.textContent = isInt ? Math.round(cur) : cur.toFixed(1);
        if (step >= steps) { clearInterval(iv); numEl.textContent = isInt ? Math.round(score) : score.toFixed(1); }
    }, 1000 / fps);
})();
</script>
