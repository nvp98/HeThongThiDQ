@model HeThongThiDQ.Models.LoginValidation
@{
    ViewBag.Title = "Thay đổi mật khẩu";
    Layout = "~/Views/Shared/_Layout.cshtml";
}
<style>
    #password-strength-status {
        padding: 5px 10px;
        color: #fff;
        border-radius: 4px;
        margin-top: 5px;
    }

    .medium-password {
        background-color: #b7d60a;
        border: #BBB418 1px solid;
    }

    .weak-password {
        background-color: #ce1d14;
        border: #AA4502 1px solid;
    }

    .strong-password {
        background-color: #12CC1A;
        border: #0FA015 1px solid;
    }
</style>

<div class="app-main__outer">
    <div class="app-main__inner">
        <div class="app-page-title">
            <div class="page-title-wrapper">
                <div class="page-title-heading">
                    <div class="page-title-icon">
                        <i class="pe-7s-config icon-gradient bg-grow-early"></i>
                    </div>
                    <div>Thay đổi mật khẩu</div>
                </div>
            </div>
        </div>

        <div class="tab-content">
            <div class="row justify-content-center">
                <div class="col-lg-5">
                    <div class="card">
                        <div class="card-header">
                            <img src="~/Content/assets/images/logo.png"
                                 style="width:100%; height:auto; max-width:230px; margin: 0 auto;" />
                        </div>
                        <div class="card-body">
                            <p class="text-center" style="text-transform:uppercase; font-weight:bold;">Thay đổi mật khẩu
                            </p>

                            <form asp-action="ChangePassword" method="post">
                                @Html.AntiForgeryToken()
                                <div asp-validation-summary="ModelOnly" class="text-danger"></div>

                                <div class="form-group">
                                    <input asp-for="MatKhauCu" type="password" class="form-control"
                                           placeholder="Nhập mật khẩu cũ" />
                                    <span asp-validation-for="MatKhauCu" class="text-danger"></span>
                                </div>
                                <div class="form-group">
                                    <input asp-for="MatKhau" type="password" class="form-control"
                                           placeholder="Nhập mật khẩu mới" onkeyup="checkPasswordStrength()" />
                                    <span asp-validation-for="MatKhau" class="text-danger"></span>
                                    <div id="password-strength-status"></div>
                                </div>
                                <div class="form-group">
                                    <input asp-for="NhapLaiMatKhau" type="password" class="form-control"
                                           placeholder="Nhập lại mật khẩu mới" onkeyup="confirmpassword()" />
                                    <span asp-validation-for="NhapLaiMatKhau" class="text-danger"></span>
                                    <span id="message"></span>
                                </div>
                                <div class="form-group">
                                    <button id="btnChangePassword" type="submit"
                                            class="form-control btn btn-primary px-3">
                                        <strong>Cập nhật</strong>
                                    </button>
                                </div>
                            </form>

                            @if (ViewBag.Message != null)
                            {
                                @Html.Raw(ViewBag.Message)
                            }
                        </div>
                    </div>
                </div>
            </div>
        </div>
    </div>
</div>

<script>
    function checkPasswordStrength() {
        var number = /([0-9])/;
        var alphabets = /([a-zA-Z])/;
        var special_characters = /([~,!,@@,#,$,%,^,&,*,-,_,+,=,?,>,<])/;
        var val = $('#MatKhau').val();
        if (val.length < 6) {
            $('#password-strength-status').removeClass().addClass('weak-password').html("Yếu (Mật khẩu nên có ít nhất 6 ký tự.)");
            return false;
        }
        if (val.match(number) && val.match(alphabets) && val.match(special_characters)) {
            $('#password-strength-status').removeClass().addClass('strong-password').html("Tốt");
        } else {
            $('#password-strength-status').removeClass().addClass('medium-password').html("Trung bình (Mật khẩu nên có ký tự số, ký tự đặc biệt, chữ cái hoa, thường.)");
        }
        return true;
    }

    function confirmpassword() {
        var pass = $('#MatKhau').val();
        var confirm = $('#NhapLaiMatKhau').val();
        if (pass !== confirm) {
            $('#message').html('Mật khẩu không khớp').css('color', 'red');
            return false;
        }
        $('#message').html('');
        return true;
    }

    $("#btnChangePassword").on('click', function () {
        if (!checkPasswordStrength()) {
            alert("Mật khẩu mới chưa tốt");
            return false;
        }
        if (!confirmpassword()) {
            alert("Xác nhận mật khẩu mới chưa đúng");
            return false;
        }
        return true;
    });
</script>
