@{
    ViewBag.Title = "Danh Sách Câu Hỏi";
    Layout = "~/Views/Shared/_Layout.cshtml";
}

@using X.PagedList
@using X.PagedList.Mvc.Core
@model IPagedList<ManageQuestionValidation>

<link href="~/Content/assets/css/PagedList.css" rel="stylesheet" />

@if (TempData["msgSuccess"] != null)
{
    @Html.Raw(TempData["msgSuccess"])
}
@if (TempData["msgError"] != null)
{
    @Html.Raw(TempData["msgError"])
}

<div class="app-main__outer">
    <div class="app-main__inner">

        <div class="app-page-title">
            <div class="page-title-wrapper">
                <div class="page-title-heading">
                    <div class="page-title-icon">
                        <i class="pe-7s-id icon-gradient bg-grow-early"></i>
                    </div>
                    <div>
                        Danh Sách Câu Hỏi
                        <div class="page-title-subheading"></div>
                    </div>
                </div>
            </div>
        </div>

        <div class="card mb-4">
            <div class="card-header">
                <div class="col-md-9">
                    <div class="row">
                        <div class="col-md-6">
                            <div class="row">
                                <select name="IDND" id="IDND" asp-items="(SelectList)ViewBag.IDND" class="form-control marginTB5" style="width:100%">
                                    <option value="">--Chọn Nội Dung--</option>
                                </select>
                            </div>
                        </div>
                        <div class="col-md-3">
                            <div class="row">
                                <select name="IDDaoCH" id="IDDaoCH" asp-items="(IEnumerable<SelectListItem>)ViewBag.IDDaoCH" class="form-control marginTB5" style="width:100%">
                                    <option value="">--Đảo câu hỏi--</option>
                                </select>
                            </div>
                        </div>
                        <div class="col-md-2">
                            <div class="input-group-btn">
                                <button class="btn btn-primary marginTB5" id="btn-search"><i class="fa fa-search"></i> Tìm kiếm</button>
                            </div>
                        </div>
                    </div>
                </div>

                @if ((ViewBag.QUYENCN as List<string>).Contains(CONSTKEY.ADD))
                {
                    <div class="col-md-3 m-l-auto">
                        <button type="button" id="btn-Import" class="btn btn-primary m-l-auto"><i class="fa fa-upload">&nbsp;</i>&nbsp;Upload</button>
                        <div class="modal fade" id="myModalimport" role="dialog" data-url="@Url.Action("ImportExcel", "Question")"></div>

                        <button type="button" id="btn-add" class="btn btn-primary m-l-auto"><i class="fa fa-plus">&nbsp;</i>&nbsp;Thêm mới</button>
                        <div class="modal fade" id="myModal" role="dialog" data-url="@Url.Action("Create", "Question")"></div>
                    </div>
                }
            </div>

            <div class="card-body">
                <div class="table-responsive">
                    <table class="table table-bordered table-hover" id="table" width="100%" cellpadding="0">
                        <thead class="thead-light">
                            <tr>
                                <th class="text-center" width="30px">STT</th>
                                <th class="text-center">Mã câu hỏi</th>
                                <th class="text-center">Nội Dung Câu Hỏi</th>
                                <th class="text-center">Đáp Án A</th>
                                <th class="text-center">Đáp Án B</th>
                                <th class="text-center">Đáp Án C</th>
                                <th class="text-center">Đáp Án D</th>
                                <th class="text-center">Đáp Án Đúng</th>
                                <th class="text-center">Đảo câu hỏi</th>
                                <th class="text-center">Thao tác</th>
                            </tr>
                        </thead>
                        <tbody>
                            @{
                                int pageno = Model.PageNumber;
                                int itemperpage = Model.PageSize;
                                int RowNo = ((pageno - 1) * itemperpage) + 1;
                            }
                            @foreach (var item in Model)
                            {
                                <tr>
                                    <td class="text-center">@RowNo@{ RowNo++; }</td>
                                    <td>@item.MaCH</td>
                                    <td>@Html.Raw(item.NoiDungCH)</td>
                                    <td>@Html.Raw(item.DapAnA)</td>
                                    <td>@Html.Raw(item.DapAnB)</td>
                                    <td>@Html.Raw(item.DapAnC)</td>
                                    <td>@Html.Raw(item.DapAnD)</td>
                                    <td>@item.DapAnDung</td>
                                    <td class="text-center">@(item.IsDao ? "Có" : "Không")</td>
                                    <td class="text-center">
                                        @if ((ViewBag.QUYENCN as List<string>).Contains(CONSTKEY.EDIT))
                                        {
                                            <a id="btn-edit_@item.IDCH" title="Sửa" class="fa fa-edit icon_action"></a>
                                            <div class="modal fade" id="myModale_@item.IDCH" role="dialog" data-url="@Url.Action("Edit", "Question", new { id = item.IDCH })"></div>
                                            <script type="text/javascript">
                                                $("#btn-edit_@item.IDCH").click(function () {
                                                    var url = $('#myModale_@item.IDCH').data('url');
                                                    tinymce.remove('.myTextarea');
                                                    $.get(url, function (data) {
                                                        $("#myModal").html(data);
                                                        $("#ModalTitle").html("Cập nhật Câu Hỏi");
                                                        $("#myModal").modal('show');
                                                    });
                                                });
                                            </script>
                                        }
                                        @if ((ViewBag.QUYENCN as List<string>).Contains(CONSTKEY.DEL))
                                        {
                                            <a class="fa fa-trash icon_action" title="Xóa"
                                               href="@Url.Action("Delete", "Question", new { id = item.IDCH })"
                                               onclick="return confirm('Bạn muốn xóa Câu Hỏi: @item.MaCH')"></a>
                                        }
                                    </td>
                                </tr>
                            }
                        </tbody>
                    </table>
                    <div class="pager">
                        @Html.PagedListPager(Model, page => Url.Action("Index", "Question", new { page, IDND = Context.Request.Query["IDND"], IDDaoCH = Context.Request.Query["IDDaoCH"] }))
                        <span class="pageoff">Trang @(Model.PageCount < Model.PageNumber ? 0 : Model.PageNumber) / @Model.PageCount</span>
                    </div>
                </div>
            </div>
        </div>

    </div>

    <div class="app-wrapper-footer">
        <div class="app-footer">
            <div class="app-footer__inner"></div>
        </div>
    </div>
</div>

<script type="text/javascript">
    $('#btn-add').click(function () {
        var url = $('#myModal').data('url');
        tinymce.remove('.myTextarea');
        $.get(url, function (data) {
            $("#myModal").html(data);
            $("#ModalTitle").html("Thêm mới câu hỏi");
            $("#myModal").modal('show');
        });
    });

    $('#btn-Import').click(function () {
        var url = $('#myModalimport').data('url');
        $.get(url, function (data) {
            $("#myModal").html(data);
            $("#ModalTitle").html("Import danh sách câu hỏi");
            $("#myModal").modal('show');
        });
    });

    $("#IDND").chosen({ width: "100%" });

    $("#btn-search").on('click', function () {
        window.location.href = '@Url.Action("Index", "Question")?IDND=' + $('#IDND').val() + '&IDDaoCH=' + $('#IDDaoCH').val();
    });
</script>
