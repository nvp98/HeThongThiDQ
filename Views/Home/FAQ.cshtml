@{
    Layout = null;
}
<!DOCTYPE html>
<html>
<head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <title>Thể lệ - QA</title>
    <style>
        body { margin: 0; background: #f4f6f8; font-family: sans-serif; }
        .faq-wrap { max-width: 900px; margin: 0 auto; padding: 24px 16px; }
        .faq-back { display: inline-block; margin-bottom: 16px; color: #05418A; font-size: 14px; text-decoration: none; font-weight: 600; }
        .faq-back:hover { text-decoration: underline; }
        .faq-img { width: 100%; display: block; border-radius: 6px; box-shadow: 0 2px 12px rgba(0,0,0,.15); }
        .faq-img + .faq-img { margin-top: 24px; }
    </style>
</head>
<body>
    <div class="faq-wrap">
        <a href="/" class="faq-back">&#8592; Quay lại trang chủ</a>
        <img src="/Content/assets/images/FAQ-QDay-1.jpg" alt="FAQ Q-Day trang 1" class="faq-img" />
        <img src="/Content/assets/images/FAQ-QDay-2.jpg" alt="FAQ Q-Day trang 2" class="faq-img" />
    </div>
</body>
</html>
